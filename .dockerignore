# Build context for the gateway image (`deploy/gateway/Dockerfile`), which
# copies only the Rust workspace: Cargo.toml, Cargo.lock, rust-toolchain.toml,
# crates/, contracts/ and the buf files.

.git
.githooks
.github
.claude
.agents
.vscode
.idea
.cache
coverage
**/coverage
artifacts
receipts
docs
tests
scripts/docs-site
.tmp*

# Rust / cargo build caches (gigabytes; not needed to copy in)
**/target/

# Host-side noise
**/.DS_Store
**/node_modules
node_modules
**/dist
dist
**/*.log
**/.env
**/.env.*
*.png

# Large / non-runtime docs and ledgers
*.md
QUALITY.md
CHANGELOG.md
ARCHITECTURE.md
CONTRIBUTING.md
AGENTS.md
CLAUDE.md

# Test / tool configs that bloat context
**/*.test.ts
**/*.integration.test.ts
**/*.contract.test.ts
**/*.perf.test.ts
**/*.scale.test.ts
**/vitest.config.ts
