{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "allowJs": false,
    "strict": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
