: [[\"whats my first thing on tuesday\", \"who's in the raku photo\", \"whats Elif's number\", \"when did i last hear from Wirra\", \"is there anything in my calendar at Banff Climbing Wall\"], [\"umm what's the first thing I've got on tuesday?\", \"oh, different thing, who's… who's in the raku photo?\", \"ok and can I get Elif's number?\", \"hmm when did I last, uh, hear from Wirra?\", \"and is there anything on the calendar at, um, Banff Climbing Wall?\"]]}\n{\"id\": \"w10-0053\", \"v\": [[\"Turns out Giveth is coming along after all, so could you add Giveth to the Elford trip group for me?\", \"I'm trying to plan around my time away, so what else is going on while I'm in Pondicherry?\", \"That sanding job won't happen before then, so can you move the sand one to tuesday instead?\", \"I'm trying to tidy up my list a bit, so could you clear out all the account to-do items?\", \"Something's come up with the appointment, so can you move the optician back a day please?\"], [\"add Giveth to Elford trip\", \"what's on while in Pondicherry?\", \"sand one to tuesday\", \"clear account to-do items\", \"optician back a day\"]]}\n{\"id\": \"w10-0054\", \"v\": [[\"For Leander in the Elford trip group, could you settle up, please?\", \"Could you tell me what I've written this month in my journal?\", \"Would you mind booking me a table at a restaurant for tonight?\", \"Could you tell me where the grocery manual went, please?\", \"Actually, never mind that, I'll check it later myself.\", \"Would you tell me what else is in that folder alongside it?\"], [\"umm so with Leander, in the Elford trip… can we settle up there?\", \"ok so what've I… what have I put this month in my journal?\", \"oh, can you book us a table somewhere for tonight? like a restaurant\", \"hmm where did the grocery manual go?\", \"ah actually scrap that, I'll, uh, I'll look later myself\", \"wait, what else is sitting in that folder with it?\"]]}\n{\"id\": \"w10-0055\", \"v\": [[\"Could you please add twenty kroner for Leander's tickets to the Elford trip? I paid for them.\", \"Could you tell me how many open tasks I have?\", \"Would you mind making the first one an hour later, please?\"], [\"I covered this at the station earlier, so can you add twenty kroner for Leander's tickets to Elford trip? I was the one who paid.\", \"I feel like my list has got out of hand lately, so how many open tasks have I actually got?\", \"That seems a lot, and I won't manage it on time anyway, so can you push the first one an hour later?\"]]}\n{\"id\": \"w10-0056\", \"v\": [[\"dustpan pic, where taken?\", \"appointments this weekend?\", \"how many notes in Raku notebook\"], [\"umm where did I take the dustpan picture?\", \"ok and what appointments have I got, uh, this weekend?\", \"oh and how many notes are in the, um, the Raku notebook?\"]]}\n{\"id\": \"w10-0057\", \"v\": [[\"umm can you log thirteen kroner for petrol in the, uh, Elford trip? I paid it\"], [\"Could you please log thirteen kroner of petrol in Elford trip? I paid for it.\"]]}\n{\"id\": \"w10-0058\", \"v\": [[\"ok so can you save the shed PIN, it's 3354, um, in the locker?\"], [\"Could you please save the shed PIN 3354 in my locker?\"]]}\n{\"id\": \"w10-0059\", \"v\": [[\"who's in partridge crew?\", \"scrap that, I'll check later\", \"delete all my contacts\"], [\"Could you tell me who is in the partridge crew group?\", \"Actually, never mind, I'll have a look later myself.\", \"Would you please erase every contact I have?\"]]}\n{\"id\": \"w11-0001\", \"v\": [[\"Could you tell me who's invited to the birdbath delivery?\", \"Would you also add a task to call Noskine back, due friday, please?\"], [\"I want to know how many to expect, so who's invited to the birdbath delivery?\", \"Oh, and I missed a call earlier and keep forgetting about it, so can you add a task to call Noskine back, due friday?\"]]}\n{\"id\": \"w11-0002\", \"v\": [[\"umm what did the racquetball delivery come to, like in total?\"], [\"how much was the racquetball delivery\"]]}\n{\"id\": \"w11-0003\", \"v\": [[\"I've let things slide a bit these last few weeks and I want to catch up, so what am I behind on?\", \"I think I can knock the fish one out tonight, so could you show me its steps?\"], [\"ok so um, what am I behind on?\", \"and the fish one, what are the, uh, the steps for it?\"]]}\n{\"id\": \"w11-0004\", \"v\": [[\"whos coming to the hyford holiday\", \"i phoned the Bertil one, log it pls\", \"no wrong one, meant the fourth one\", \"pull up Vymie\"], [\"hyford holiday guests?\", \"phoned the Bertil one, log it\", \"no, the fourth one\", \"Vymie?\"]]}\n{\"id\": \"w11-0005\", \"v\": [[\"umm when's my birdbath thing?\", \"oh different thing, how much have I spent on Hampi, like, in total?\"], [\"when's birdbath?\", \"Hampi spend total?\"]]}\n{\"id\": \"w11-0006\", \"v\": [[\"birdbath stuff?\", \"tick off the wrap one\"], [\"what birdbath stuff have i got\", \"tick off the wrap one thx\"]]}","ttft_ms":15068,"type":"result","duration_ms":32665,"uuid":"cf80140d-db7a-4523-a61f-d81aa7a78742","ttft_stream_ms":1935,"time_to_request_ms":110,"first_content_frame_ms":1935,"time_to_request_from_spawn_ms":21996618,"warm_spare_claimed":false,"time_origin_ms":1790278547075.0903,"queued_turn_count":0,"result_index":0}
