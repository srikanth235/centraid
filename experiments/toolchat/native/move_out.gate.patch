           SUMS
+      # The built and frozen data of the native task is not in the tree (R-1088-14,
+      # `artefacts.json`). What a builder or the seeder reproduces byte for byte is
+      # rebuilt here: the worlds, and the keys of the val worlds. The rest (the frozen
+      # sets, the r1 build, the keys of the other worlds) comes from the private Hub
+      # repository at the revision the manifest records, and needs the secret. A run
+      # without it (a pull request from a fork) rebuilds only, and the tests that read
+      # a frozen keys file fail by name.
+      - name: Materialise the built and frozen artefacts
+        working-directory: experiments/toolchat/native
+        env:
+          NATIVETOOLS: ${{ github.workspace }}/target/debug/nativetools
+          HF_TOKEN: ${{ secrets.HF_TOKEN }}
+        run: |
+          set -euo pipefail
+          if [ -n "${HF_TOKEN}" ]; then
+            python artefacts.py fetch
+            python artefacts.py check
+          else
+            echo "::warning::HF_TOKEN is not available: rebuilding only; the tests that read the frozen keys files will fail"
+            python artefacts.py fetch --rebuild-only
+          fi
       # `test_loop` and `test_retry` drive the eval harness over a seeded vault of
       # world A. Seeding is deterministic and leaves the tracked keys file as it is.
       - name: Seed world A
