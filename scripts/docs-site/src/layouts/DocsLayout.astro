---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import SectionRail from '../components/SectionRail.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHead from '../components/SiteHead.astro';

const {
  title,
  description,
  current = 'home',
  canonicalPath = '',
  bodyClass = '',
  rail = [],
  footer = undefined,
  noIndex = false,
  pageType = 'TechArticle',
  searchLabel = undefined,
  searchKeywords = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://centraid.dev/docs/').toString();
const docsHome = new URL('', Astro.site ?? 'https://centraid.dev/docs/').toString();
const shareImage = new URL('assets/og-docs.svg', Astro.site ?? 'https://centraid.dev/docs/').toString();
// docs.css/docs.js live in public/ and ship UN-fingerprinted, so a returning
// visitor can run a cached old script against fresh HTML — which is exactly how
// the header search "broke" (old JS reads a data-index that no longer exists,
// fetches `undefined`, shows no results). Stamp each asset with a short hash of
// its own bytes so any change mints a new URL and defeats the stale cache. The
// smoke test strips `?query` before resolving links, so this stays valid.
// The docs build always runs from the repo root (see scripts/docs-site/build.mjs),
// where the un-fingerprinted source assets live under scripts/docs-site/public.
const assetHash = (assetPath) => {
  try {
    const abs = path.join(process.cwd(), 'scripts', 'docs-site', 'public', assetPath);
    return createHash('sha1').update(readFileSync(abs)).digest('hex').slice(0, 10);
  } catch {
    return '';
  }
};
const asset = (assetPath) => {
  const v = assetHash(assetPath);
  return `${base}${assetPath}${v ? `?v=${v}` : ''}`;
};
const pageName = title.replace(/\s+[—-]\s+Centraid docs.*$/u, '').trim();
const pageLabel = searchLabel ?? pageName;
const breadcrumbItems = [
  { name: 'Centraid', url: 'https://centraid.dev/' },
  { name: 'Docs', url: docsHome },
];
if (canonical !== docsHome) {
  breadcrumbItems.push({ name: pageName, url: canonical });
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://centraid.dev/#organization',
      name: 'Centraid',
      url: 'https://centraid.dev/',
    },
    {
      '@type': 'WebSite',
      '@id': `${docsHome}#website`,
      url: docsHome,
      name: 'Centraid documentation',
      description:
        'Docs for Centraid, a local-first personal superapp: one shell wrapping many first-party apps over a private data vault, across peer-to-peer devices.',
      publisher: { '@id': 'https://centraid.dev/#organization' },
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    },
    {
      '@type': pageType,
      '@id': `${canonical}#primary`,
      name: pageName,
      headline: pageName,
      description,
      image: shareImage,
      url: canonical,
      isPartOf: { '@id': `${docsHome}#website` },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      publisher: { '@id': 'https://centraid.dev/#organization' },
      mainEntityOfPage: canonical,
      inLanguage: 'en',
    },
  ],
};
const jsonLdHtml = JSON.stringify(jsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Resolve the theme before first paint. NO `data-theme` means "follow the
        system", which the generated token sheet answers with its own
        `prefers-color-scheme` block — so the attribute is set here only when
        the visitor has actually chosen one. docs.js (bottom of body) also
        syncs it, but on a heavy page like the ontology it runs late enough
        that a wrong-theme paint is visible as a light→dark flash; setting it
        here, blocking in <head>, means no page ever paints the wrong theme.
        Keep the storage key and the legacy migration in sync with docs.js. */}
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('centraid-theme');
        } catch {
          /* storage blocked (private mode) — fall through to the media query */
        }
        // `paper`/`night` were this site's theme names before it moved onto
        // the product's tokens; migrate a returning visitor's choice.
        const legacy = { night: 'dark', paper: 'light' };
        if (legacy[theme]) theme = legacy[theme];
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noIndex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }
    <meta name="application-name" content="Centraid docs" />
    {/* The product's own two page grounds (packages/design's `--bg`). */}
    <meta name="theme-color" content="#FDFDFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E0E" media="(prefers-color-scheme: dark)" />
    <meta data-pagefind-meta="label[content]" content={pageLabel} />
    <meta data-pagefind-meta="description[content]" content={description} />
    <meta data-pagefind-meta="keywords[content]" content={searchKeywords} />
    <meta data-pagefind-default-meta="image[content]" content={shareImage} />
    <meta data-pagefind-default-meta="image_alt[content]" content="Centraid documentation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType === 'CollectionPage' ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Centraid docs" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Centraid documentation" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content="Centraid documentation" />
    <link rel="icon" href={asset('assets/centraid-mark.svg')} />
    {/* The one bundled face, served from this origin. Nothing here reaches a
        font CDN: the product ships Instrument Sans with no network fetch, and
        a local-first product's docs should not open with a third-party
        request. The tokens must load BEFORE docs.css, which resolves every
        colour, rung and duration through them. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}assets/fonts/instrument-sans-latin-400-normal.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}assets/fonts/instrument-sans-latin-600-normal.woff2`}
      crossorigin
    />
    <link rel="stylesheet" href={asset('assets/centraid-tokens.css')} />
    <link rel="stylesheet" href={asset('assets/docs.css')} />
    {!noIndex && <script type="application/ld+json" set:html={jsonLdHtml}></script>}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SiteHead current={current} />
    <SectionRail items={rail} />
    <main data-pagefind-body={noIndex ? undefined : true}>
      <slot />
    </main>
    <SiteFooter footer={footer} />
    <script is:inline src={asset('assets/docs.js')}></script>
  </body>
</html>
