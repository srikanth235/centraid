---
import DocsLayout from '../layouts/DocsLayout.astro';
import content from '../content/index.html?raw';

const rail = [];
const footer = {
  "manifesto": "Most software is built for everyone, so none of it fits anyone. <em>Yours can just fit you.</em>",
  "links": [
    {
      "href": "https://centraid.dev",
      "label": "centraid.dev",
      "external": false
    },
    {
      "href": "start/",
      "label": "start",
      "external": false
    },
    {
      "href": "ontology/",
      "label": "ontology",
      "external": false
    }
  ]
};
---

<DocsLayout
  title="Centraid Docs: Your Phone Vault and Built-In Apps"
  description="Learn how Centraid keeps one vault on your phone, with nine built-in apps and a gateway that stores sealed backups."
  current="home"
  canonicalPath=""
  searchLabel="Home"
  searchKeywords="phone vault built-in apps Calendar Reminders People Notes Docs Photos Money Health Locker gateway sealed backup recovery key"
  bodyClass=""
  rail={rail}
  footer={footer}
  pageType="CollectionPage"
>
  <Fragment set:html={content} />
</DocsLayout>
