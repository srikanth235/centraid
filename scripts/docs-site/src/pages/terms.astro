---
import DocsLayout from '../layouts/DocsLayout.astro';
import content from '../content/terms.html?raw';

const rail = [
  { href: '#service', no: '§01', label: 'The service', current: true },
  { href: '#responsibility', no: '§02', label: 'Responsibility', current: false },
  { href: '#availability', no: '§03', label: 'Availability', current: false },
  { href: '#contact', no: '§04', label: 'Contact', current: false },
];
---

<DocsLayout
  title="Centraid Terms of Service"
  description="Terms for Centraid: open-source software with no account and no hosted service, your responsibility for your recovery key and backups, and no warranty."
  current="terms"
  canonicalPath="terms/"
  searchLabel="Terms"
  searchKeywords="terms service license open source responsibility recovery key backup device availability warranty"
  bodyClass="has-rail"
  rail={rail}
  pageType="WebPage"
>
  <Fragment set:html={content} />
</DocsLayout>
