---
import DocsLayout from '../layouts/DocsLayout.astro';
import content from '../content/404.html?raw';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const body = content.replaceAll('__DOCS_BASE__', base);
---

<DocsLayout
  title="Not found — Centraid docs"
  description="The requested Centraid docs page was not found."
  current="none"
  canonicalPath="404.html"
  bodyClass=""
  noIndex={true}
>
  <Fragment set:html={body} />
</DocsLayout>
