---
import DocsLayout from '../layouts/DocsLayout.astro';
import content from '../content/understand.html?raw';

const rail = [
  {
    "href": "#pillars",
    "no": "§01",
    "label": "Phone, apps, backup",
    "current": true
  },
  {
    "href": "#ontology",
    "no": "§02",
    "label": "Shared record model",
    "current": false
  },
  {
    "href": "#index",
    "no": "§03",
    "label": "Where to go next",
    "current": false
  }
];
const footer = {
  "manifesto": "One phone vault, shared by built-in apps. <em>A gateway stores sealed backups.</em>",
  "links": [
    {
      "href": "../start/",
      "label": "start",
      "external": false
    },
    {
      "href": "../data/",
      "label": "data",
      "external": false
    },
    {
      "href": "../apps/",
      "label": "apps",
      "external": false
    },
    {
      "href": "../devices/",
      "label": "devices",
      "external": false
    }
  ]
};
---

<DocsLayout
  title="How Centraid Works: Phone Vault, Apps, and Backup"
  description="Understand the phone-only vault, nine built-in apps, shared records, and the blind gateway that stores sealed backups."
  current="understand"
  canonicalPath="understand/"
  searchLabel="Understand"
  searchKeywords="architecture phone vault Rust core SwiftUI Android built-in apps Calendar Reminders People Notes Docs Photos Money Health Locker gateway sealed backup pairing code recovery key"
  bodyClass="has-rail"
  rail={rail}
  footer={footer}
>
  <Fragment set:html={content} />
</DocsLayout>
