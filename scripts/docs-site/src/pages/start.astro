---

<DocsLayout
  title="Get started with Centraid on your phone"
  description="Build the pre-release iOS or Android app, use the nine first-party apps on Home, and pair a gateway for sealed backups."
  current="start"
  canonicalPath="start/"
  searchLabel="Start"
  searchKeywords="phone iOS Android build source native Home Docs Photos Notes People Calendar Reminders Money Health Locker document note reminder gateway backup recovery key"
  bodyClass="has-rail"
  rail={rail}
