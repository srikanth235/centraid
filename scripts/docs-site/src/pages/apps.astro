---
import DocsLayout from '../layouts/DocsLayout.astro';
import content from '../content/apps.html?raw';

const rail = [
  { "href": '#apps', "no": '§01', "label": 'The apps', "current": true },
];
const footer = {
  "manifesto": 'Nine apps, one phone vault. <em>Your records stay together.</em>',
  "links": [
    { "href": 'https://centraid.dev', "label": 'centraid.dev', "external": false },
    { "href": '../start/', "label": 'start', "external": false },
    { "href": '../data/', "label": 'data', "external": false },
    { "href": '../devices/', "label": 'devices', "external": false },
  ],
};
---

<DocsLayout
  title="Centraid Apps: Nine First-Party Apps Over One Phone Vault"
  description="Meet Centraid's nine apps and learn how they share records, links, history, search, trash and export over the phone vault."
  current="apps"
  canonicalPath="apps/"
  searchLabel="Apps"
  searchKeywords="apps Docs Photos Notes People Locker Calendar Reminders Money Health vault records links history trash export search"
  bodyClass="has-rail"
  rail={rail}
  footer={footer}
>
  <Fragment set:html={content} />
</DocsLayout>
