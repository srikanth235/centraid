---
import DocsLayout from '../layouts/DocsLayout.astro';
import content from '../content/data.html?raw';

const rail = [
  { "href": '#vault', "no": '§01', "label": 'The vault', "current": true },
  { "href": '#records', "no": '§02', "label": 'Records and protection', "current": false },
  { "href": '#backup', "no": '§03', "label": 'Sealed backup', "current": false },
];
const footer = {
  "manifesto": 'The phone holds the live vault. <em>Backup devices hold sealed copies.</em>',
  "links": [
    { "href": 'https://centraid.dev', "label": 'centraid.dev', "external": false },
    { "href": '../start/', "label": 'start', "external": false },
    { "href": '../apps/', "label": 'apps', "external": false },
    { "href": '../devices/', "label": 'devices', "external": false },
  ],
};
---

<DocsLayout
  title="Centraid data: the phone vault and shared records"
  description="Learn where live records live, how apps share them, and what a sealed backup contains."
  current="data"
  canonicalPath="data/"
  searchLabel="Data"
  searchKeywords="vault SQLite phone records entities links history search Locker sealed backup gateway recovery"
  bodyClass="has-rail"
  rail={rail}
  footer={footer}
>
  <Fragment set:html={content} />
</DocsLayout>
