{
  "name": "@centraid/agent-runtime",
  "version": "0.1.0",
  "private": false,
  "description": "Unified local agent runtime for centraid: drives one turn over the Agent Client Protocol for every runner kind, launching first-party ACP adapters for CLIs that lack an ACP mode. Used by both the per-app data chat and the builder. Ships a tiny `centraid` CLI bin agents shell out to.",
  "license": "SEE LICENSE IN REPOSITORY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikanth235/centraid.git",
    "directory": "packages/agent-runtime"
  },
  "bin": {
    "centraid": "./dist/cli/centraid-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/backends/acp && cp src/backends/acp/vault-mcp-stdio-proxy.mjs dist/backends/acp/",
    "clean": "rm -rf dist",
    "probe:all-adapters": "bun scripts/probe-all-adapters.ts",
    "test": "vitest run",
    "test:live-adapters": "bun scripts/live-adapter-smoke.ts",
    "test:live-automation-failover": "CENTRAID_LIVE_AUTOMATION=1 vitest run src/automation/live-automation-failover.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.65.0",
    "@agentclientprotocol/codex-acp": "1.1.13",
    "@centraid/app-engine": "workspace:*",
    "@centraid/automation": "workspace:*"
  },
  "devDependencies": {
    "@centraid/test-kit": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.5"
  }
}
