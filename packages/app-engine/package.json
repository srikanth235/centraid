{
  "name": "@centraid/app-engine",
  "version": "0.1.0",
  "private": false,
  "description": "Centraid runtime engine — handler loader, sqlite-backed apps, versioned uploads, and the /centraid HTTP surface. Transport-agnostic; consumed by the standalone daemon and the desktop in-process runtime.",
  "license": "SEE LICENSE IN REPOSITORY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikanth235/centraid.git",
    "directory": "packages/app-engine"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/pricing/litellm-snapshot.json dist/pricing/litellm-snapshot.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@centraid/test-kit": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.5"
  }
}
