{
  // The HOST surface only (#1011). `packages/server` runs from `dist/` under
  // plain node, so the one entry a host imports — the model manifest, the
  // provision path over it, and the system handlers' model ids — must be
  // emitted JavaScript. Everything else in this package is loaded by bun
  // (`setup.ts`, the bundle build) or by a generated handler from its own
  // bundle, and stays source-only: `capabilities/*` and `onnx.ts` reach for
  // native addons that are not workspace dependencies, and nothing would be
  // served by shipping them here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "files": [
    "src/index.ts",
    "src/model-assets.ts",
    "src/model-ids.ts",
    "src/config.ts",
    "src/types.ts"
  ]
}
