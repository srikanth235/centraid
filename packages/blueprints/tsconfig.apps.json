{
  // Typecheck-only config for the browser-side blueprint apps (TS + CSS-modules
  // conversion). Each shell bundles these sources rather than compiling them
  // through tsc, so this program never emits: it exists purely to gate the
  // `.ts`/`.tsx` app + handler sources against strict types, plus the shared
  // ambient declarations under `types/`. Apps import each other by their real
  // extension (`./logic.ts`, `./Board.tsx`), hence
  // `allowImportingTsExtensions` (requires `noEmit`); everything shared beyond
  // one app is an ordinary package import (`@centraid/design/elements`).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/**/*.d.ts",
    "types/**/*.d.ts"
  ]
}
