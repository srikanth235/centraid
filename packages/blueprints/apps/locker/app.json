      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["item_id", "field_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "writes": ["locker.item_field"]
    },
    {
      "name": "set-addresses",
      "description": "Replace a login's ADDITIONAL addresses through locker.set_addresses, each with its own match policy — registrable domain or exact host. The item's primary address is unchanged.",
      "confirmation": "none",
      "input": {
        "type": "object",
