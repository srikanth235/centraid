    {
      "name": "set-passkey",
      "description": "Store or restate an item's passkey slot through locker.set_passkey: relying-party id, user handle, credential id, algorithm, and sealed private key material. Storage only — this performs no WebAuthn ceremony.",
      "confirmation": "none",
      "input": {
        "type": "object",
