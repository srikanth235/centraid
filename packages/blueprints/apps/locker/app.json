          "otp_seed": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "cardholder": {
            "type": "string"
          },
          "card_number": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          },
          "cvv": {
