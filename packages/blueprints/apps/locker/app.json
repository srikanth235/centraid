      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "writes": []
    }
  ],
  "queries": [
    {
      "name": "auth",
      "description": "Online-only Locker authentication control plane. Passphrases and memory-session tokens bypass the replica intent ledger and are never persisted in receipts.",
      "input": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "status",
              "configure",
              "unlock",
              "authorize-item",
              "lock",
              "enroll-device",
              "revoke-device"
            ]
          },
          "sessionToken": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "credentialId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": ["operation"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "configured": {
            "type": "boolean"
          },
          "authenticated": {
            "type": "boolean"
          },
          "sessionToken": {
            "type": "string"
          },
          "itemToken": {
            "type": "string"
          },
          "credentialId": {
            "type": "string"
          },
          "expiresAt": {
