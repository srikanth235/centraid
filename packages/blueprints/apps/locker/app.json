      ]
    },
    {
      "name": "set-field",
      "description": "Create or rewrite ONE owner-defined field on an item through locker.set_field. A field is (section, label, kind, value); a sealed kind stores its value in a sealed vault column, so it is ciphertext at rest and a keyed hash in the journal. Sending «sealed» back leaves the stored secret alone. One field per call so a secret is always a top-level input the journal redaction can reach.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["text", "sealed", "url", "date", "otp"]
          },
          "value": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["item_id", "label", "kind"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "writes": ["locker.item_field"]
    },
    {
      "name": "remove-field",
