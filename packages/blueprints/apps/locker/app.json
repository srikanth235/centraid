      "input": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean"
          },
          "include_trashed": {
            "type": "boolean"
          },
          "include_history": {
            "type": "boolean"
          }
        },
        "required": ["confirm"],
        "additionalProperties": false
