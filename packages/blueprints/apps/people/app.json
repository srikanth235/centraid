{
  "manifestVersion": 1,
  "id": "people",
  "name": "People",
  "description": "Your circle, remembered — a personal CRM projected from the canonical vault. people_profile keeps only the genuine 1:1 CRM decoration; interactions are core activities, tasks are schedule tasks, relationships are typed core links, IOUs are Tally obligations, and journal entries are knowledge notes. Lists, favorites, notes, important dates, and gift ideas reuse the vault's shared mechanisms too. Every write runs through a typed command — consent-checked and receipted. No data of its own — revoke the grant and the app goes dark.",
  "version": "0.1.2",
  "iconKey": "Users",
  "colorKey": "violet",
  "vault": {
    "why": "Keeps light records on the people you care about and nudges you to stay in touch.",
    "scopes": [
      { "schema": "people", "verbs": "read+act" },
      { "schema": "core", "table": "party", "verbs": "read" },
      { "schema": "core", "table": "vault", "verbs": "read" },
      { "schema": "core", "table": "party_identifier", "verbs": "read" },
      { "schema": "core", "table": "activity", "verbs": "read" },
      { "schema": "core", "table": "link", "verbs": "read" },
      { "schema": "core", "table": "content_item", "verbs": "read" },
      { "schema": "core", "table": "tag", "verbs": "read" },
      { "schema": "core", "table": "concept", "verbs": "read" },
      { "schema": "core", "table": "concept_scheme", "verbs": "read" },
      { "schema": "knowledge", "table": "annotation", "verbs": "read" },
      { "schema": "knowledge", "table": "note", "verbs": "read" },
      { "schema": "schedule", "table": "task", "verbs": "read" },
      { "schema": "tally", "table": "obligation", "verbs": "read" },
      { "schema": "social", "table": "contact_channel", "verbs": "read" },
      { "schema": "share", "table": "party_vault_binding", "verbs": "read" },
      { "schema": "share", "table": "authority", "verbs": "read" },
      { "schema": "share", "table": "authority_use", "verbs": "read" },
      { "schema": "share", "table": "authority_request", "verbs": "read" },
      { "schema": "share", "table": "commons_invitation", "verbs": "read" },
      { "schema": "social", "table": "save_contact_channel", "verbs": "act" },
      {
        "schema": "social",
        "table": "delete_contact_channel",
        "verbs": "act"
      },
      {
        "schema": "social",
        "table": "undo_contact_channel",
        "verbs": "act"
      },
      {
        "schema": "core",
        "table": "merge_party",
        "verbs": "act"
      },
      {
        "schema": "core",
        "table": "entity_revision",
        "verbs": "read",
        "rowFilter": [
          {
            "column": "entity_type",
            "op": "eq",
            "value": "people.person"
          }
        ],
        "fieldMask": [
          "revision_id",
          "entity_type",
          "entity_id",
          "operation",
          "snapshot_json",
          "recorded_at",
          "undo_until",
          "undone_at"
        ]
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "add-person",
      "description": "Add a person to your circle through people.add_person — mints a canonical core.party plus its people_profile, optionally filed into a list. Risk low.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": {
            "type": "string",
            "minLength": 1,
            "description": "The row id the seat minted for this write (#922 G2); omitted, the vault mints one."
          },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "avatar_color": { "type": "string" },
          "cadence_days": { "type": "integer", "minimum": 0 },
          "list_id": { "type": "string", "minLength": 1 }
        },
        "required": ["display_name", "cadence_days"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.party", "core.tag", "people.profile"]
    },
    {
      "name": "edit-person",
      "description": "Revise a person's name, role line, avatar hue or how-you-met note through people.edit_person.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "avatar_color": { "type": "string" },
          "met": { "type": "string" }
        },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.party", "outbox.item", "people.profile"]
    },
    {
      "name": "set-cadence",
      "description": "Set how often you want to reach out to a person through people.set_cadence.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "cadence_days": { "type": "integer", "minimum": 0 }
        },
        "required": ["party_id", "cadence_days"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["people.profile"]
    },
    {
      "name": "trash-person",
      "description": "Move a People profile to reversible 30-day trash while preserving its canonical party and linked facts.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["people.profile"]
    },
    {
      "name": "restore-person",
      "description": "Restore a People profile from its grace-window trash.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["people.profile"]
    },
    {
      "name": "undo-person",
      "description": "Apply one People pre-mutation snapshot exactly once, restoring edits, cadence, or trash state.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "revision_id": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id", "revision_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.entity_revision", "core.party", "people.profile"]
    },
    {
      "name": "log-interaction",
      "description": "Log a touch (message, call, met up, note) through people.log_interaction; stamps last-contacted so they drop off Reconnect.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "text": { "type": "string" }
        },
        "required": ["party_id", "kind"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.activity",
        "core.concept",
        "core.concept_scheme",
        "core.link",
        "knowledge.annotation",
        "people.profile"
      ]
    },
    {
      "name": "star-person",
      "description": "Favorite a person through people.star_person — the one canonical flags-scheme star, shared across your vault.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "party_id": { "type": "string", "minLength": 1 } },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.concept",
        "core.concept_scheme",
        "core.party",
        "core.tag"
      ]
    },
    {
      "name": "unstar-person",
      "description": "Remove a person's favorite star through people.unstar_person.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "party_id": { "type": "string", "minLength": 1 } },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.concept",
        "core.concept_scheme",
        "core.party",
        "core.tag"
      ]
    },
    {
      "name": "move-person",
      "description": "Move a person into a list through people.move_person — omit list_id to un-list them.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "list_id": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.party", "core.tag"]
    },
    {
      "name": "add-note",
      "description": "Add a note about a person through people.add_note — kept as a searchable annotation on their party.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id", "text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["knowledge.annotation"]
    },
    {
      "name": "add-task",
      "description": "Add a follow-up task tied to a person through people.add_task.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id", "text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.concept",
        "core.concept_scheme",
        "core.link",
        "schedule.task"
      ]
    },
    {
      "name": "toggle-task",
      "description": "Toggle a person task between open and done through people.toggle_task.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "task_id": { "type": "string", "minLength": 1 } },
        "required": ["task_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["schedule.task"]
    },
    {
      "name": "add-important-date",
      "description": "Add an important date (birthday, anniversary…) through people.add_important_date; birthdays auto-create their reminder. month_day is MM-DD.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "month_day": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
          "reminder_on": { "type": "boolean" }
        },
        "required": ["party_id", "label", "month_day"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.party", "outbox.item", "people.important_date"]
    },
    {
      "name": "toggle-reminder",
      "description": "Turn a date's reminder on or off through people.toggle_reminder.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "date_id": { "type": "string", "minLength": 1 } },
        "required": ["date_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["people.important_date"]
    },
    {
      "name": "add-relationship",
      "description": "Record a typed core.link to a related canonical party through people.add_relationship; related_party_id reuses an existing party.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "pet": { "type": "string" },
          "related_party_id": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id", "name", "kind"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.concept",
        "core.concept_scheme",
        "core.link",
        "core.party"
      ]
    },
    {
      "name": "add-gift",
      "description": "Add a gift idea for a person through people.add_gift.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "required": ["party_id", "text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.concept",
        "core.concept_scheme",
        "core.link",
        "schedule.task"
      ]
    },
    {
      "name": "toggle-gift",
      "description": "Flip a gift between idea and given through people.toggle_gift.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "gift_id": { "type": "string", "minLength": 1 } },
        "required": ["gift_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["schedule.task"]
    },
    {
      "name": "add-debt",
      "description": "Record a debt you owe a person or they owe you through people.add_debt, in minor units.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "party_id": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "enum": ["owe", "owed"] },
          "amount_minor": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" }
        },
        "required": ["party_id", "direction", "amount_minor"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["tally.friend", "tally.obligation"]
    },
    {
      "name": "settle-debt",
      "description": "Settle a debt through people.settle_debt (marks it closed, kept as history).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "debt_id": { "type": "string", "minLength": 1 } },
        "required": ["debt_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["tally.obligation"]
    },
    {
      "name": "create-list",
      "description": "Create a list (a SKOS concept in your lists scheme) through people.create_list, like a Docs folder.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "list_id": {
          "type": "string",
          "minLength": 1,
          "description": "The row id the seat minted for this write (#922 G2); omitted, the vault mints one."
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.concept", "core.concept_scheme"]
    },
    {
      "name": "rename-list",
      "description": "Rename a list through people.rename_list.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "list_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "required": ["list_id", "name"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.concept"]
    },
    {
      "name": "delete-list",
      "description": "Delete an empty list through people.delete_list (move its people out first).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "list_id": { "type": "string", "minLength": 1 } },
        "required": ["list_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["core.concept"]
    },
    {
      "name": "add-journal-entry",
      "description": "Add an owner-level journal entry with a mood and a line about your day through people.add_journal_entry.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "mood": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "entry_date": { "type": "string" }
        },
        "required": ["mood", "text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.concept",
        "core.concept_scheme",
        "core.content_item",
        "core.tag",
        "knowledge.note"
      ]
    },
    {
      "name": "save-contact-channel",
      "description": "Create or edit a normalized phone, email, address, or handle, including label, preferred status, provenance, and duplicate warnings.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "party_id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["phone", "email", "address", "handle"]
          },
          "label": { "type": "string" },
          "value": { "type": "string", "minLength": 1 },
          "preferred": { "type": "boolean" },
          "provenance": { "type": "object" }
        },
        "required": ["party_id", "kind", "value"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["outbox.item", "social.contact_channel"]
    },
    {
      "name": "delete-contact-channel",
      "description": "Delete one contact channel with a durable one-shot undo revision.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 }
        },
        "required": ["channel_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": ["outbox.item", "social.contact_channel"]
    },
    {
      "name": "undo-contact-channel",
      "description": "Restore a contact channel edit or deletion from its one-shot revision.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "revision_id": { "type": "string", "minLength": 1 }
        },
        "required": ["channel_id", "revision_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": [
        "core.entity_revision",
        "outbox.item",
        "social.contact_channel"
      ]
    },
    {
      "name": "merge-people",
      "description": "Fold a duplicate person into a survivor via core.merge_party — every FK re-points and the merged party is deleted. Irreversible; confirm-gated.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "source_party_id": { "type": "string", "minLength": 1 },
