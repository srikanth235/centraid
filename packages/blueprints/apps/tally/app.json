{
  "manifestVersion": 1,
  "id": "tally",
  "name": "Tally",
  "description": "Split, settled — a personal expense splitter as a projection of the vault. Track shared costs across groups and friends, see who owes whom, and settle up. A friend is a canonical core.party; a group is a social.circle (the vault's one audience mechanism) decorated by a tally.group with an emoji icon, membership on the circle (you included); an expense stores its resolved splits (equally, exact amounts or percentages), re-validated server-side to sum to the amount; a settlement is a real cash payment. Balances are NEVER stored — they are derived at read time by the balance engine. Adding, editing and deleting expenses, settling up, and managing groups and friends all run through typed vault commands — consent-checked and receipted. No data of its own — revoke the grant and the app goes dark.",
  "version": "0.1.1",
  "iconKey": "Receipt",
  "colorKey": "indigo",
  "vault": {
    "purpose": "dpv:ServiceProvision",
    "why": "Keeps your shared expenses split, balanced and settled.",
    "scopes": [
      { "schema": "core", "table": "vault", "verbs": "read" },
      { "schema": "core", "table": "party", "verbs": "read" },
      { "schema": "core", "table": "content_item", "verbs": "read" },
      { "schema": "tally", "table": "friend", "verbs": "read" },
      { "schema": "tally", "table": "group", "verbs": "read" },
      { "schema": "social", "table": "circle", "verbs": "read" },
      { "schema": "social", "table": "circle_member", "verbs": "read" },
      { "schema": "tally", "table": "expense", "verbs": "read" },
      { "schema": "tally", "table": "expense_split", "verbs": "read" },
      { "schema": "tally", "table": "expense_receipt", "verbs": "read" },
      { "schema": "tally", "table": "expense_line_item", "verbs": "read" },
      {
        "schema": "tally",
        "table": "expense_line_allocation",
        "verbs": "read"
      },
      { "schema": "tally", "table": "settlement", "verbs": "read" },
      { "schema": "tally", "table": "obligation", "verbs": "read" },
      { "schema": "tally", "table": "recurring_expense", "verbs": "read" },
      {
        "schema": "schedule",
        "table": "recurrence_exception",
        "verbs": "read"
      },
      { "schema": "tally", "table": "add_friend", "verbs": "act" },
      { "schema": "tally", "table": "create_group", "verbs": "act" },
      { "schema": "tally", "table": "rename_group", "verbs": "act" },
      { "schema": "tally", "table": "add_group_member", "verbs": "act" },
      { "schema": "tally", "table": "remove_group_member", "verbs": "act" },
      { "schema": "tally", "table": "delete_group", "verbs": "act" },
      { "schema": "tally", "table": "add_expense", "verbs": "act" },
      { "schema": "tally", "table": "add_receipt_expense", "verbs": "act" },
      { "schema": "tally", "table": "edit_expense", "verbs": "act" },
      { "schema": "tally", "table": "delete_expense", "verbs": "act" },
      { "schema": "tally", "table": "restore_expense", "verbs": "act" },
      { "schema": "tally", "table": "undo_expense", "verbs": "act" },
      { "schema": "tally", "table": "settle_up", "verbs": "act" },
      {
        "schema": "tally",
        "table": "save_recurring_expense",
        "verbs": "act"
      },
      {
        "schema": "tally",
        "table": "materialize_recurring_expense",
        "verbs": "act"
      },
      {
        "schema": "tally",
        "table": "edit_recurring_expense_occurrence",
        "verbs": "act"
      },
      {
        "schema": "core",
        "table": "entity_revision",
        "verbs": "read",
        "rowFilter": [
          {
            "column": "entity_type",
            "op": "eq",
            "value": "tally.expense"
          }
        ],
        "fieldMask": [
          "revision_id",
          "entity_type",
          "entity_id",
          "operation",
          "snapshot_json",
          "recorded_at",
          "undo_until",
          "undone_at"
        ]
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "add-receipt-expense",
      "description": "Publish a reviewed receipt image as canonical content together with OCR line items, tax/tip rows, per-line participant allocations, and the resulting balanced expense.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "amount_minor": { "type": "integer", "minimum": 1 },
          "paid_by": { "type": "string", "minLength": 1 },
          "spent_on": { "type": "string" },
          "category": { "type": "string" },
          "staged_sha": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "ocr_text": { "type": "string", "minLength": 1 },
          "splits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "party_id": { "type": "string" },
                "share_minor": { "type": "integer" }
              },
              "required": ["party_id", "share_minor"],
              "additionalProperties": false
            }
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["item", "tax", "tip"]
                },
                "description": { "type": "string", "minLength": 1 },
                "amount_minor": { "type": "integer", "minimum": 0 },
                "allocations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "party_id": { "type": "string" },
                      "share_minor": { "type": "integer" }
                    },
                    "required": ["party_id", "share_minor"],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "kind",
                "description",
                "amount_minor",
                "allocations"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "group_id",
          "description",
          "amount_minor",
          "paid_by",
          "category",
          "staged_sha",
          "ocr_text",
          "splits",
          "line_items"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "add-expense",
      "description": "Add an expense through tally.add_expense. The split method (equally / exact / percent) is resolved to a splits map client-side; the command re-validates it sums to the amount and every participant is a group member.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "amount_minor": { "type": "integer", "minimum": 1 },
          "original_amount_minor": { "type": "integer", "minimum": 1 },
          "original_currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" },
          "settlement_currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "rate_scaled": { "type": "integer", "minimum": 1 },
          "rate_scale": { "type": "integer", "minimum": 0, "maximum": 12 },
          "rate_source": { "type": "string", "minLength": 1 },
          "rate_date": { "type": "string", "minLength": 1 },
          "paid_by": { "type": "string", "minLength": 1 },
          "spent_on": { "type": "string" },
          "category": { "type": "string" },
          "splits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "party_id": { "type": "string" },
                "share_minor": { "type": "integer" }
              },
              "required": ["party_id", "share_minor"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "group_id",
          "description",
          "amount_minor",
          "paid_by",
          "category",
          "splits"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "save-recurring-expense",
      "description": "Create or edit a deterministic recurring expense template with fixed-point currency provenance and a human-readable recurrence preview.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "group_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "original_amount_minor": { "type": "integer", "minimum": 1 },
          "original_currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" },
          "settlement_currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "paid_by": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "splits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "party_id": { "type": "string", "minLength": 1 },
                "weight": { "type": "integer", "minimum": 1 }
              },
              "required": ["party_id", "weight"],
              "additionalProperties": false
            }
          },
          "rrule": { "type": "string", "minLength": 1 },
          "anchor_start": { "type": "string", "minLength": 1 },
          "time_zone": { "type": "string", "minLength": 1 },
          "rate_scaled": { "type": "integer", "minimum": 1 },
          "rate_scale": { "type": "integer", "minimum": 0, "maximum": 12 },
          "rate_source": { "type": "string", "minLength": 1 },
          "rate_date": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "ended"]
          }
        },
        "required": [
          "group_id",
          "description",
          "original_amount_minor",
          "original_currency",
          "settlement_currency",
          "paid_by",
          "category",
          "splits",
          "rrule",
          "anchor_start",
          "time_zone"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "materialize-recurring-expense",
      "description": "Materialize one exact recurring occurrence idempotently, respecting occurrence/future exceptions.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "original_start": { "type": "string", "minLength": 1 }
        },
        "required": ["template_id", "original_start"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "edit-recurring-expense-occurrence",
      "description": "Skip or override this occurrence, this and future occurrences, or the full recurring expense series.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "original_start": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "string",
            "enum": ["occurrence", "future", "series"]
          },
          "action": { "type": "string", "enum": ["skip", "override"] },
          "override": { "type": "object" }
        },
        "required": ["template_id", "original_start", "scope", "action"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "edit-expense",
      "description": "Rewrite an expense through tally.edit_expense — same fields as add, re-validated the same way.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "expense_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "amount_minor": { "type": "integer", "minimum": 1 },
          "original_amount_minor": { "type": "integer", "minimum": 1 },
          "original_currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" },
          "settlement_currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "rate_scaled": { "type": "integer", "minimum": 1 },
          "rate_scale": { "type": "integer", "minimum": 0, "maximum": 12 },
          "rate_source": { "type": "string", "minLength": 1 },
          "rate_date": { "type": "string", "minLength": 1 },
          "paid_by": { "type": "string", "minLength": 1 },
          "spent_on": { "type": "string" },
          "category": { "type": "string" },
          "splits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "party_id": { "type": "string" },
                "share_minor": { "type": "integer" }
              },
              "required": ["party_id", "share_minor"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "expense_id",
          "description",
          "amount_minor",
          "paid_by",
          "category",
          "splits"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "delete-expense",
      "description": "Delete an expense through tally.delete_expense.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": { "expense_id": { "type": "string", "minLength": 1 } },
        "required": ["expense_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "undo-expense",
      "description": "Apply one durable pre-edit or pre-trash expense snapshot exactly once.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "expense_id": { "type": "string", "minLength": 1 },
          "revision_id": { "type": "string", "minLength": 1 }
        },
        "required": ["expense_id", "revision_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "restore-expense",
      "description": "Restore a soft-deleted expense and its preserved splits through tally.restore_expense.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": { "expense_id": { "type": "string", "minLength": 1 } },
        "required": ["expense_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "settle-up",
      "description": "Record a cash payment through tally.settle_up (from → to), paying balances down.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "from_party": { "type": "string", "minLength": 1 },
          "to_party": { "type": "string", "minLength": 1 },
          "amount_minor": { "type": "integer", "minimum": 1 },
          "group_id": { "type": "string", "minLength": 1 },
          "paid_on": { "type": "string" }
        },
        "required": ["from_party", "to_party", "amount_minor"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "add-friend",
      "description": "Add a friend through tally.add_friend — mints a canonical person party. The avatar hue is derived from the party, not stored here.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "create-group",
      "description": "Create a group through tally.create_group — name, icon and member party ids (you are added automatically).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "color": { "type": "string" },
          "member_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "icon", "member_ids"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "rename-group",
      "description": "Rename a group through tally.rename_group.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "required": ["group_id", "name"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "add-group-member",
      "description": "Add a member to a group through tally.add_group_member.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "party_id": { "type": "string", "minLength": 1 }
        },
        "required": ["group_id", "party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "remove-group-member",
      "description": "Remove a member from a group through tally.remove_group_member — refused while they are on the ledger.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "party_id": { "type": "string", "minLength": 1 }
        },
        "required": ["group_id", "party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    },
    {
      "name": "delete-group",
      "description": "Delete an empty group through tally.delete_group — refused while it still holds expenses.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": { "group_id": { "type": "string", "minLength": 1 } },
        "required": ["group_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "output": { "type": "object" },
          "reason": { "type": "string" }
        }
      },
      "writes": []
    }
  ],
  "queries": [
    {
      "name": "dashboard",
      "description": "The home view: the owner party id (`me`), the base currency, per-friend net balances (positive = they owe you), the you-owe / you-are-owed totals, and each group's net for the owner. All balances are derived from expenses and settlements — never stored.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "me": { "type": ["string", "null"] },
          "currency": { "type": "string" },
          "friends": { "type": "array" },
          "groups": { "type": "array" },
          "trash": { "type": "array" },
          "owe_total_minor": { "type": "integer" },
          "owed_total_minor": { "type": "integer" },
          "vaultDenied": { "type": "object" }
        }
      }
    },
    {
      "name": "group",
      "description": "One group: its meta, members with their net balances, and the expense ledger (newest first), each row decorated with the owner's lent/borrowed amount and its per-person splits.",
      "input": {
        "type": "object",
        "properties": { "group_id": { "type": "string", "minLength": 1 } },
        "required": ["group_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "me": { "type": ["string", "null"] },
          "currency": { "type": "string" },
          "group": { "type": ["object", "null"] },
          "members": { "type": "array" },
          "ledger": { "type": "array" },
          "vaultDenied": { "type": "object" }
        }
      }
    },
    {
      "name": "friend",
      "description": "One friend: the net balance with them and the expenses you both took part in (newest first), decorated the same way as a group ledger.",
      "input": {
        "type": "object",
        "properties": { "party_id": { "type": "string", "minLength": 1 } },
        "required": ["party_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "me": { "type": ["string", "null"] },
          "currency": { "type": "string" },
          "friend": { "type": ["object", "null"] },
          "ledger": { "type": "array" },
          "vaultDenied": { "type": "object" }
        }
      }
    },
    {
      "name": "activity",
      "description": "Expenses and settlements interleaved, newest first, each carrying the owner's role and the display names needed to render a one-line entry.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "me": { "type": ["string", "null"] },
          "currency": { "type": "string" },
          "activity": { "type": "array" },
          "vaultDenied": { "type": "object" }
