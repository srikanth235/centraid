{
  "name": "@centraid/blueprints",
  "version": "0.1.0",
  "private": false,
  "description": "The superapp's catalogue: the bundled first-party system apps installed in place, and the automation templates cloned into user-owned automation code.",
  "license": "SEE LICENSE IN REPOSITORY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikanth235/centraid.git",
    "directory": "packages/blueprints"
  },
  "files": [
    "dist",
    "apps",
    "automations",
    "index.json",
    "manifest.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apps/_shared/format-kit": "./apps/_shared/format-kit.ts",
    "./apps/agenda/app-inline": "./apps/agenda/app-inline.tsx",
    "./apps/docs/app-inline": "./apps/docs/app-inline.tsx",
    "./apps/locker/app-inline": "./apps/locker/app-inline.tsx",
    "./apps/notes/app-inline": "./apps/notes/app-inline.tsx",
    "./apps/people/app-inline": "./apps/people/app-inline.tsx",
    "./apps/photos/app-inline": "./apps/photos/app-inline.tsx",
    "./apps/tally/app-inline": "./apps/tally/app-inline.tsx",
    "./apps/tasks/app-inline": "./apps/tasks/app-inline.tsx",
    "./apps/*": "./apps/*.ts",
    "./apps/_shared/*": "./apps/_shared/*.ts",
    "./apps/agenda/*": "./apps/agenda/*.ts",
    "./apps/docs/*": "./apps/docs/*.ts",
    "./apps/locker/*": "./apps/locker/*.ts",
    "./apps/notes/*": "./apps/notes/*.ts",
    "./apps/people/*": "./apps/people/*.ts",
    "./apps/photos/*": "./apps/photos/*.ts",
    "./apps/tally/*": "./apps/tally/*.ts",
    "./apps/tasks/*": "./apps/tasks/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:manifest && tsc -p tsconfig.build.json",
    "build:manifest": "node scripts/build-manifest.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && bun run typecheck:apps",
    "typecheck:apps": "tsc -p tsconfig.apps.json --noEmit"
  },
  "dependencies": {
    "@centraid/core": "workspace:*",
    "@centraid/design": "workspace:*",
    "pdfjs-dist": "6.1.200",
    "tldts": "7.4.9"
  },
  "devDependencies": {
    "@centraid/test-kit": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.17",
    "esbuild": "^0.28.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.5"
  }
}
