{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // `src/elements/**` is the DOM subtree and compiles under
  // tsconfig.elements.json instead: `lib: ["ES2023"]` above is the token
  // layer's Expo-safety gate, and it only means anything while this program
  // holds nothing that needs a `document`.
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/elements/**"]
}
