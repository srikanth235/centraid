{
  "name": "@centraid/design",
  "version": "0.1.0",
  "private": false,
  "description": "Centraid's design system: the token vocabulary (tokens layer) and the blueprint app kit served to app surfaces (kit layer).",
  "license": "SEE LICENSE IN REPOSITORY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikanth235/centraid.git",
    "directory": "packages/design"
  },
  "files": [
    "dist",
    "fonts",
    "src",
    "kit"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./font-faces": {
      "types": "./dist/font-faces.d.ts",
      "react-native": "./src/font-faces.ts",
      "default": "./dist/font-faces.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "react-native": "./src/color.ts",
      "default": "./dist/color.js"
    },
    "./css-vars": {
      "types": "./dist/css-vars.d.ts",
      "react-native": "./src/css-vars.ts",
      "default": "./dist/css-vars.js"
    },
    "./oklab": {
      "types": "./dist/oklab.d.ts",
      "react-native": "./src/oklab.ts",
      "default": "./dist/oklab.js"
    },
    "./kit/*": "./kit/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@centraid/blob-format": "workspace:*",
    "@fontsource/dm-mono": "5.2.5",
    "@fontsource/instrument-sans": "5.2.5",
    "@fontsource/instrument-serif": "5.2.5",
    "@fontsource/source-serif-4": "5.2.5"
  },
  "devDependencies": {
    "@centraid/test-kit": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "catalog:"
  }
}
