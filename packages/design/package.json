{
  "name": "@centraid/design",
  "version": "0.1.0",
  "private": false,
  "description": "Centraid's design system: the token vocabulary (token layer) and the browser element substrate the apps render on (element layer).",
  "license": "SEE LICENSE IN REPOSITORY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikanth235/centraid.git",
    "directory": "packages/design"
  },
  "files": [
    "dist",
    "fonts",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "default": "./dist/elements/index.js"
    },
    "./kit.css": "./src/elements/kit.css",
    "./native": {
      "types": "./dist/native.d.ts",
      "react-native": "./src/native.ts",
      "default": "./dist/native.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./font-faces": {
      "types": "./dist/font-faces.d.ts",
      "react-native": "./src/font-faces.ts",
      "default": "./dist/font-faces.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "react-native": "./src/blocks/index.ts",
      "default": "./dist/blocks/index.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "react-native": "./src/color.ts",
      "default": "./dist/color.js"
    },
    "./css-vars": {
      "types": "./dist/css-vars.d.ts",
      "react-native": "./src/css-vars.ts",
      "default": "./dist/css-vars.js"
    },
    "./oklab": {
      "types": "./dist/oklab.d.ts",
      "react-native": "./src/oklab.ts",
      "default": "./dist/oklab.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.elements.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.2.5"
  },
  "devDependencies": {
    "@centraid/test-kit": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "catalog:"
  }
}
