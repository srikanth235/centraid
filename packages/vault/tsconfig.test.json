{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The scripted fixture lives beside the package, not inside its build
    // (#996): it is test-only and ships as source. Nothing is emitted here.
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
