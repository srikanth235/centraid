#!/usr/bin/env bash
# The commit subject is `type(scope)!: subject (#N)`: a Conventional Commits
# type, an optional scope, and the GitHub issue the change answers to. A
# squash merge's subject is the PR title, so `gate.yml` runs this same file
# over the title. Merge, revert and autosquash subjects are git's own wording
# and pass. Skip with `git commit --no-verify`.
set -euo pipefail

subject="$(sed -n '/^[[:space:]]*#/d; /[^[:space:]]/{p;q;}' "$1")"

case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|chore|docs|refactor|test|perf|build|ci|revert|style'
pattern="^($types)(\\([^)]+\\))?!?: .+ \\(#[1-9][0-9]*\\)\$"
if [[ ! "$subject" =~ $pattern ]]; then
  echo "commit-msg: subject must read \`type(scope): subject (#N)\`, types: ${types//|/, }" >&2
  echo "  got: $subject" >&2
  exit 1
fi
if ((${#subject} > 100)); then
  echo "commit-msg: subject is ${#subject} characters; the limit is 100" >&2
  exit 1
fi
