#!/usr/bin/env bash
# Format and lint check over the STAGED files, with the repo's own configs.
# CI checks the whole tree (`cargo xtask gate`'s `ts-static` step); this
# catches the same thing before the commit exists. Fix with `bun run format`
# and `bun run lint:fix`. Skip with `git commit --no-verify`.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
bin="$root/node_modules/.bin"
if [[ ! -x "$bin/oxfmt" || ! -x "$bin/oxlint" ]]; then
  echo "pre-commit: oxfmt/oxlint not installed — run \`bun install\` to enable this hook" >&2
  exit 0
fi

fmt=()
lint=()
while IFS= read -r file; do
  case "$file" in
    *.ts | *.tsx | *.js | *.jsx | *.mjs | *.cjs | *.mts | *.cts)
      fmt+=("$file")
      lint+=("$file")
      ;;
    *.json | *.jsonc | *.yml | *.yaml | *.css | *.md | *.html | *.astro)
      fmt+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

status=0
if ((${#fmt[@]})); then
  "$bin/oxfmt" -c oxfmt.config.ts --disable-nested-config --no-error-on-unmatched-pattern --check "${fmt[@]}" || status=1
fi
if ((${#lint[@]})); then
  "$bin/oxlint" -c oxlint.config.ts --disable-nested-config --deny-warnings "${lint[@]}" || status=1
fi
exit "$status"
