#!/usr/bin/env bash
# governance-kit:managed kit-version=0.14.0
# Governance pre-commit hook — generated by governance-bootstrap.
#
# Escape hatches:
#   SKIP_GOVERNANCE=1 git commit ...    # telegraphs intent; CI still enforces
#   git commit --no-verify              # skips all hooks

set -u

if [[ "${SKIP_GOVERNANCE:-0}" == "1" ]]; then
    echo "⊘ governance pre-commit skipped (SKIP_GOVERNANCE=1)" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
GOVERNANCE_DIR="$ROOT/.governance"

directive_field() {
    local manifest="$1" field="$2"
    [[ -f "$manifest" ]] || return 0
    awk -v k="$field" '
        /^[[:space:]]*#/ { next }
        $0 ~ "^[[:space:]]*" k ":[[:space:]]*" {
            line = $0
            sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", line)
            sub(/[[:space:]]+#.*$/, "", line)
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line ~ /^".*"$/ || line ~ /^'\''.*'\''$/) {
                line = substr(line, 2, length(line) - 2)
            }
            print line
            exit
        }
    ' "$manifest"
}

directive_dirs_for_hook() {
    local kind="$1" mode="$2"
    local dir hook helper
    [[ -d "$GOVERNANCE_DIR" ]] || return 0
    while IFS= read -r dir; do
        [[ -d "$dir" && -f "$dir/directive.yaml" ]] || continue
        hook="$(directive_field "$dir/directive.yaml" hook)"
        helper="$dir/hooks/$kind.sh"
        case "$mode" in
            helper)
                [[ -x "$helper" ]] && printf '%s\n' "$dir"
                ;;
            check)
                [[ "$hook" == "$kind" && -x "$dir/check.sh" ]] && printf '%s\n' "$dir"
                ;;
        esac
    done < <(
        [[ -d "$GOVERNANCE_DIR/packs" ]] && find "$GOVERNANCE_DIR/packs" -type d -path '*/directives/*' | sort
    )
}
# ── centraid: deferred-directives (#915) ──────────────────────────────────
# Rung 0's budget is 5 s. Two vendored `governance-kit` directives cost 86.3 s
# of it on this tree — `repo-hygiene` (51.2 s, `git grep` + `git ls-files`
# across every tracked file) and `receipt-per-issue` (35.1 s, re-reads the
# receipt corpus) — because both are repo-wide BY CONSTRUCTION and cannot be
# scoped to the staged set.
#
# Their `hook:` field cannot be changed in-tree: both folders carry digests in
# `.governance/packs.lock`, so `managed-tree-integrity` fails on a hand edit.
# The kit exposes no supported override either — `.governance/lib.sh` reads
# `hook:` straight out of `directive.yaml`, and `conf_get`/`conf_list` only
# serve keys a directive DECLARES in its own `config:` block, which `hook` is
# not.
#
# So the deferral lives here, in a file the kit does not digest
# (`.governance/install.yaml` covers only `governance.yml`, `lib.sh` and
# `run.sh`): this hook skips the ids listed in the conf below and
# `.githooks/pre-push` runs exactly those before `check:push`. Nothing is
# dropped. `.governance/run.sh` still runs all 22 directives, so the CI
# enforcing copy is untouched and only the LOCAL rung moved, 0 → 1.
#
# Cost of re-adding a directive here: read the conf's own rules first.
DEFERRED_CONF="$GOVERNANCE_DIR/conf/srikanth235/centraid/pre-commit-deferred.conf"

deferred_directive_ids() {
    [[ -f "$DEFERRED_CONF" ]] || return 0
    sed -e 's/#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$DEFERRED_CONF" \
        | grep -v '^$' || true
}

directive_is_deferred() {
    local id="$1" listed
    while IFS= read -r listed; do
        [[ "$listed" == "$id" ]] && return 0
    done < <(deferred_directive_ids)
    return 1
}

if [[ -x "$ROOT/scripts/test.sh" ]]; then
    bash "$ROOT/scripts/test.sh" || exit 1
elif [[ -x "$ROOT/scripts/test-packs.sh" ]]; then
    bash "$ROOT/scripts/test-packs.sh" || exit 1
fi

while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    bash "$dir/hooks/pre-commit.sh" || exit 1
done < <(directive_dirs_for_hook pre-commit helper)

# Sub-agent attestation orchestration (issue #325). Directives declaring a
# `judge:` block register any pending attestation into a shared ledger as
# their check.sh runs; after the loop we emit one independent remediation
# instruction per pending section. Guarded so an older lib.sh is a no-op.
ATTEST_LEDGER=""
if [[ -f "$GOVERNANCE_DIR/lib.sh" ]]; then
    # shellcheck disable=SC1091
    source "$GOVERNANCE_DIR/lib.sh"
    if declare -F attestation_remediation >/dev/null 2>&1; then
        ATTEST_LEDGER="$(mktemp)"
        export GOVERNANCE_ATTEST_LEDGER="$ATTEST_LEDGER"
        trap 'rm -f "$ATTEST_LEDGER"' EXIT
    fi
fi

fail=0
while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    id="$(basename "$dir")"
    if directive_is_deferred "$id"; then
        printf '⏭ %s deferred to pre-push (#915)\n' "$id" >&2
        continue
    fi
    bash "$dir/check.sh" || fail=1
done < <(directive_dirs_for_hook pre-commit check)

[[ -n "$ATTEST_LEDGER" ]] && attestation_remediation "$ATTEST_LEDGER"

if [[ $fail -ne 0 ]]; then
    cat >&2 <<EOF

────────────────────────────────────────
✗ Commit blocked by governance.

Fix the violations above, or bypass (CI will still enforce):
    SKIP_GOVERNANCE=1 git commit ...
    git commit --no-verify
────────────────────────────────────────
EOF
    exit 1
fi

exit 0
