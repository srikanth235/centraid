#!/usr/bin/env bash
# governance-kit:managed kit-version=0.14.0
# Governance pre-push hook — generated by governance-bootstrap.
#
# Escape hatches:
#   SKIP_GOVERNANCE=1 git push ...      # telegraphs intent; CI still enforces
#   git push --no-verify                # skips all hooks

set -u

if [[ "${SKIP_GOVERNANCE:-0}" == "1" ]]; then
    echo "⊘ governance pre-push skipped (SKIP_GOVERNANCE=1)" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
GOVERNANCE_DIR="$ROOT/.governance"
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

REFS_FILE="$(mktemp)"
trap 'rm -f "$REFS_FILE"' EXIT
cat > "$REFS_FILE"
directive_field() {
    local manifest="$1" field="$2"
    [[ -f "$manifest" ]] || return 0
    awk -v k="$field" '
        /^[[:space:]]*#/ { next }
        $0 ~ "^[[:space:]]*" k ":[[:space:]]*" {
            line = $0
            sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", line)
            sub(/[[:space:]]+#.*$/, "", line)
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line ~ /^".*"$/ || line ~ /^'\''.*'\''$/) {
                line = substr(line, 2, length(line) - 2)
            }
            print line
            exit
        }
    ' "$manifest"
}

directive_dirs_for_hook() {
    local kind="$1" mode="$2"
    local dir hook helper
    [[ -d "$GOVERNANCE_DIR" ]] || return 0
    while IFS= read -r dir; do
        [[ -d "$dir" && -f "$dir/directive.yaml" ]] || continue
        hook="$(directive_field "$dir/directive.yaml" hook)"
        helper="$dir/hooks/$kind.sh"
        case "$mode" in
            helper)
                [[ -x "$helper" ]] && printf '%s\n' "$dir"
                ;;
            check)
                [[ "$hook" == "$kind" && -x "$dir/check.sh" ]] && printf '%s\n' "$dir"
                ;;
        esac
    done < <(
        [[ -d "$GOVERNANCE_DIR/packs" ]] && find "$GOVERNANCE_DIR/packs" -type d -path '*/directives/*' | sort
    )
}
# ── centraid: deferred-directives (#915) ──────────────────────────────────
# The other half of the rung-0 deferral. `.githooks/pre-commit` skips the
# directive ids listed in the conf below (repo-wide, digest-locked, 86.3 s
# between them); this hook runs exactly those, before `check:push`, so a push
# still carries the same 22 directives a commit used to. `.governance/run.sh`
# — what CI invokes — was never changed, so the enforcing copy always ran all
# of them regardless. See the block in `.githooks/pre-commit` for why the
# directives' own `hook:` field could not be moved instead.
DEFERRED_CONF="$GOVERNANCE_DIR/conf/srikanth235/centraid/pre-commit-deferred.conf"

deferred_directive_ids() {
    [[ -f "$DEFERRED_CONF" ]] || return 0
    sed -e 's/#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$DEFERRED_CONF" \
        | grep -v '^$' || true
}

# Print the directive folder for each deferred id, in conf order. An id that
# names no installed directive is silently absent rather than fatal: the conf
# is a deferral list, not an installation manifest, and a hook that refuses to
# run because a vendored pack was dropped would block every push.
deferred_directive_dirs() {
    local id dir
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        while IFS= read -r dir; do
            [[ -d "$dir" && -x "$dir/check.sh" ]] || continue
            [[ "$(basename "$dir")" == "$id" ]] && printf '%s\n' "$dir"
        done < <(
            [[ -d "$GOVERNANCE_DIR/packs" ]] \
                && find "$GOVERNANCE_DIR/packs" -type d -path '*/directives/*' | sort
        )
    done < <(deferred_directive_ids)
}

while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    bash "$dir/hooks/pre-push.sh" "$REMOTE_NAME" "$REMOTE_URL" < "$REFS_FILE" || exit 1
done < <(directive_dirs_for_hook pre-push helper)

fail=0

# ── centraid: gate stamps (#988) ──────────────────────────────────────────
# The deferred directives are ~86 s of repo-wide `git grep`, and five agents in
# this container push several times an hour from worktrees whose trees are often
# byte-identical to one these directives already cleared. `gate-stamp.mjs` keys
# a pass on (working tree oid, `origin/main`) and skips the loop on a match; a
# green loop re-stamps. CI reads no stamp (the module disables itself under
# `CI`), so the enforcing copy always recomputes. `CENTRAID_GATE_STAMPS=0`
# turns it off — the knob only ever makes more run.
#
# Git's hook environment is stripped for the same reason `pre-push-gate` strips
# it: `GIT_DIR` and friends override cwd, and this reads git plumbing.
GATE_STAMP="$ROOT/scripts/ci/gate-stamp.mjs"
stamp_cmd() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
        -u GIT_PREFIX -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        node "$GATE_STAMP" "$1" governance-deferred
}

deferred_stamped=0
if [[ -f "$GATE_STAMP" ]] && command -v node >/dev/null 2>&1 && stamp_cmd check; then
    deferred_stamped=1
    printf '⊘ deferred directives stamped for this tree — skipped (CENTRAID_GATE_STAMPS=0 to re-run)\n' >&2
fi

# Deferred first: they are cheap relative to `check:push` and their failures
# are the ones a developer fixes without re-running the gate.
deferred_fail=0
if [[ $deferred_stamped -eq 0 ]]; then
    while IFS= read -r dir; do
        [[ -z "$dir" ]] && continue
        bash "$dir/check.sh" || deferred_fail=1
    done < <(deferred_directive_dirs)
    [[ $deferred_fail -ne 0 ]] && fail=1
    if [[ $deferred_fail -eq 0 && -f "$GATE_STAMP" ]] && command -v node >/dev/null 2>&1; then
        stamp_cmd record
    fi
fi
while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    bash "$dir/check.sh" "$REMOTE_NAME" "$REMOTE_URL" < "$REFS_FILE" || fail=1
done < <(directive_dirs_for_hook pre-push check)

if [[ $fail -ne 0 ]]; then
    cat >&2 <<EOF

────────────────────────────────────────
✗ Push blocked by governance.

Fix the violations above, or bypass (CI will still enforce):
    SKIP_GOVERNANCE=1 git push ...
    git push --no-verify
────────────────────────────────────────
EOF
    exit 1
fi

exit 0
