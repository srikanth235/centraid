  {
    "function": {
      "description": "Run a verb on rows (or kind for app-level verbs). Ends the turn unless more.",
      "name": "do",
      "parameters": {
        "properties": {
          "args": {
            "description": "reschedule to · add_to/attach/link to · remove_from/detach/unlink from · respond answer · categorize category · merge into · restore_version version · recolor label, color · tag/untag label · log kind · reveal field",
            "type": "string"
          },
          "kind": {
            "description": "for app-level or rowless verbs (export, import, follow, unfollow, empty_trash, apply, configure)",
            "type": "string"
          },
          "more": {
            "description": "another call follows",
            "type": "boolean"
          },
          "rows": {
            "description": "#n, @n list",
            "type": "string"
          },
          "verb": {
            "enum": [
              "reschedule",
              "complete",
              "reopen",
              "cancel",
              "delete",
              "restore",
              "star",
              "unstar",
              "add_to",
              "remove_from",
              "log",
              "reveal",
              "undo",
              "tag",
              "untag",
              "attach",
              "detach",
              "respond",
              "categorize",
              "link",
              "unlink",
              "merge",
              "purge",
              "import",
              "duplicate",
              "archive",
              "unarchive",
              "apply",
              "empty_trash",
              "unfollow",
              "restore_version",
              "recolor",
              "export",
              "follow",
              "edit_media",
              "configure"
            ],
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
