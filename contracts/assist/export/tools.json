[
  {
    "function": {
      "description": "Rows a selector matches, numbered #n, as result @n; text searches names; rows=#n opens one row.",
      "name": "find",
      "parameters": {
        "properties": {
          "exclude": {
            "description": "#n, #m",
            "type": "string"
          },
          "kind": {
            "description": "a kind or a comma list",
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "linked_to": {
            "description": "#n",
            "type": "string"
          },
          "name": {
            "description": "words, any order; the only name filter",
            "type": "string"
          },
          "order": {
            "description": "field asc|desc; one kind only",
            "type": "string"
          },
          "rows": {
            "description": "#n: every fact and link of one row",
            "type": "string"
          },
          "text": {
            "description": "fuzzy name search across the vault; kind narrows it",
            "type": "string"
          },
          "trashed": {
            "description": "only trashed rows",
            "type": "boolean"
          },
          "when": {
            "description": "the only date filter, on the kind's date. rel: offset in units, 0 = this; name: month 1..12; weekday: 1..7 Mon..Sun; time: HH:MM; date: YYYY-MM-DD; from, to: a span, one end may be open; anchor row: the target's own date (act)",
            "properties": {
              "anchor": {
                "enum": [
                  "today",
                  "row"
                ],
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "from": {
                "type": "object"
              },
              "name": {
                "type": "integer"
              },
              "rel": {
                "type": "integer"
              },
              "time": {
                "type": "string"
              },
              "to": {
                "type": "object"
              },
              "unit": {
                "enum": [
                  "minute",
                  "hour",
                  "day",
                  "week",
                  "month",
                  "year"
                ],
                "type": "string"
              },
              "weekday": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "where": {
            "description": "field = value (!= < <= > >=), contains \"…\", in (\"a\", \"b\"), is empty, is set, <kind> count >= N; joined by and; one kind",
            "type": "string"
          },
          "within": {
            "description": "@n to narrow",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "A value for a later step, or one per group value; selector params as in find.",
      "name": "compute",
      "parameters": {
        "properties": {
          "exclude": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "group": {
            "description": "a field to group by, or a period of the kind's date: day, week, month, year",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "linked_to": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "op": {
            "enum": [
              "count",
              "sum",
              "avg",
              "min",
              "max",
              "compare"
            ],
            "type": "string"
          },
          "order": {
            "type": "string"
          },
          "rows": {
            "description": "#n, @n list",
            "type": "string"
          },
          "trashed": {
            "type": "boolean"
          },
          "when": {
            "description": "date expression, as in find",
            "type": "object"
          },
          "where": {
            "type": "string"
          },
          "within": {
            "type": "string"
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
