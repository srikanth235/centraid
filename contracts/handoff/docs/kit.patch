+/// The asset-owned half of a kit index.
+fn narrow(index: &RepresentationIndex) -> BTreeMap<String, String> {
+    index
+        .by_owner
+        .iter()
+        .filter(|((owner_type, _), _)| owner_type == ASSET_OWNER_TYPE)
+        .map(|((_, owner_id), media_type)| (owner_id.clone(), media_type.clone()))
+        .collect()
