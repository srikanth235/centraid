# A GUESS MUST NOT BE DRAWN AS A FACT.
#
# Two fields on one detail say it twice, and this fixture is where they are
# checked together:
#
#   - `people` holds CONFIRMED face regions only. A proposal belongs to face
#     review; naming one here would put an unconfirmed guess in the facts panel,
#     under a heading that says the vault knows this.
#   - `labels` carry the member's own tags and a derivation's proposals in ONE
#     list — they are the same table with different confidence — so each row
#     says which with `confirmed`. This fixture carries one of each, because a
#     view that drew them identically would pass a fixture with only one kind.
#
# `SHEET_INFO` is the surface that shows all of it, and it is a sheet over a
# photograph that is still on screen, not a route away from it.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
asset_id: "ast-0320"
