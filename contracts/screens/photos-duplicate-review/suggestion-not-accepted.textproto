# A SUGGESTION THE MEMBER HAS NOT ACCEPTED CANNOT DELETE ANYTHING.
#
# `suggested_keep_asset_id` is set. `keep_asset_id` is EMPTY. That gap is the
# whole fixture, and it is the most important one in the photos set, because the
# act on the other side of this screen is irreversible-shaped: resolving a
# cluster trashes every member but the kept one, and "the kept one" is read from
# `keep_asset_id`.
#
# Write the suggestion into `keep_asset_id` as a convenience — pre-select the
# largest, it is almost always right — and the screen now has a default answer
# to "which of your photographs should I delete?", supplied by the product. A
# member who taps Resolve without reading has deleted three photographs they
# never chose to lose. The recommendation stays a RECOMMENDATION: it lives in
# `data`, beside the reason for it, and crossing into the decision field takes a
# tap.
#
# `suggestion_reason` is stated rather than implied, so the member can disagree
# with the ARGUMENT and not just the answer. Here it is bytes; the member may
# care more that one copy is in an album.
#
# The reducer's obligation follows from these bytes: Resolve with
# `keep_asset_id` empty is not a write.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
cluster_id: "dup-0002"
data {
  members {
    asset_id: "ast-0401"
    thumbnail_path: "thumbs/ast-0401.jpg"
    byte_size: 8412672
    width: 4032
    height: 3024
    captured_at: "2026-03-22T07:45:00Z"
    member_placed: false
    held: HELD_ORIGINAL
  }
  members {
    asset_id: "ast-0402"
    thumbnail_path: "thumbs/ast-0402.jpg"
    byte_size: 1204736
    width: 1512
    height: 1134
    captured_at: "2026-03-22T07:45:00Z"
    member_placed: false
    held: HELD_THUMBNAIL_ONLY
  }
  suggested_keep_asset_id: "ast-0401"
  suggestion_reason: "Largest file — 8.4 MB, 4032 × 3024."
}
