# TWO COPIES THAT ARE THE SAME SIZE, AND NOTHING TO RECOMMEND.
#
# `suggested_keep_asset_id` is empty and so is `suggestion_reason`. The rule
# that produces a suggestion is "the largest by bytes"; when the members are
# byte-identical it has no answer, and the honest state is silence. A screen
# that always shows a recommendation would have to invent one — the first row,
# the newest, whichever the sort happened to put on top — and dress an arbitrary
# pick as advice.
#
# `keep_asset_id` is empty too, as it must be: no suggestion and no choice means
# nothing is keepable and Resolve does nothing. Compare
# `photos-duplicate-review/suggestion-not-accepted`, where the recommendation
# exists and is still not the decision. Empty-because-there-is-none and
# empty-because-not-yet-accepted are the same bytes in `keep_asset_id`, and that
# is correct: both mean "the member has not chosen", and the screen must not act
# in either.
#
# The two differ in `captured_at` — the same photograph imported twice, minutes
# apart — which is one of the four facts a member compares, and the only one
# that distinguishes these.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
cluster_id: "dup-0003"
data {
  members {
    asset_id: "ast-0410"
    thumbnail_path: "thumbs/ast-0410.jpg"
    byte_size: 1048576
    width: 2048
    height: 1536
    captured_at: "2026-02-08T18:03:00Z"
    member_placed: false
    held: HELD_ORIGINAL
  }
  members {
    asset_id: "ast-0411"
    thumbnail_path: "thumbs/ast-0411.jpg"
    byte_size: 1048576
    width: 2048
    height: 1536
    captured_at: "2026-02-08T18:07:00Z"
    member_placed: false
    held: HELD_ORIGINAL
  }
}
