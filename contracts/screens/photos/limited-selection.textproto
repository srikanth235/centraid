# iOS's LIMITED selection. Not an empty library and not a denial: the backup
# runs over the photos the member chose, and the sentence says so.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
destination: DESTINATION_LIBRARY
permission: MEDIA_PERMISSION_LIMITED
data {
  cells {
    asset_id: "ast-0002"
    captured_at: "2026-09-01T09:00:00Z"
    captured_utc_offset_minutes: 60
    kind: KIND_PHOTO
    capture_group_id: "cg-live-0002"
  }
}
backup {
  phase: PHASE_TRANSFERRING
  assets_remaining: 12
  assets_transferred_this_session: 38
  bytes_transferred_this_session: 194512384
  paused_reason: "Centraid imports the photos you selected."
}
sheet: SHEET_NONE
# The import's progress and the selection's remedy; no "Import now" over a
# library that has photographs, and none while a pass is running.
import_banner {
  sentence: "Importing: 38 done, 12 to go"
  reason: "Centraid imports the photos you selected."
  remedy: REMEDY_MANAGE_SELECTION
  allow_label: "Allow photo access"
  settings_label: "Open Settings"
  manage_label: "Manage selection"
  import_now_label: "Import now"
}
