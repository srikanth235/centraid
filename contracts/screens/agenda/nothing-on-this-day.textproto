# AN EMPTY DAY IS NOT AN EMPTY CALENDAR. Tomorrow holds nothing; the calendar
# does, so this is `NOTHING_ON_DAY` and offers no "add the first one". Compare
# `day-one`.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
destination: DESTINATION_DAY
anchor_day: "2026-03-12"
data {
  today: "2026-03-11"
  now_local: "2026-03-11T09:42"
  empty: AGENDA_EMPTY_NOTHING_ON_DAY
  empty_title: "Nothing on this day."
  calendars {
    calendar_id: "calendar-home"
    name: "Home"
    hue_key: "cTeal"
    hidden: false
    state_label: "Shown"
  }
  waiting_count: 0
  event_count: 0
  event_count_label: "0 events"
}
sheet: SHEET_NONE
band { key: "day" label: "Day" icon_key: "Clock" current: true }
band { key: "schedule" label: "Schedule" icon_key: "List" current: false }
band { key: "waiting" label: "Waiting" icon_key: "Inbox" current: false }
band { key: "search" label: "Search" icon_key: "Search" current: false }
band { key: "more" label: "More" icon_key: "more" current: false }
toolbar {
  shown: true
  range_label: "Tomorrow"
  month_label: "March 2026"
  at_today: false
}
chrome { title: "Agenda" new_event: "New event" today: "Today" }
