# Today, with the now line placed AMONG the rows rather than drawn over them,
# an event awaiting the member's reply, and one whose write this device still
# holds — a row status from `pending_event_ids`, never a separate list. The
# landing is today's section, at its now line.
# A task due today is a row on the day (R-1128-2), untimed, ahead of the timed
# rows; its box checks it off in place.
# The More sheet's rows ride on the state, so both platforms draw one list:
# each calendar a toggle under the Calendars heading, the Tasks places under
# theirs, then the reads row.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
destination: DESTINATION_DAY
anchor_day: "2026-03-11"
data {
  today: "2026-03-11"
  now_local: "2026-03-11T09:42"
  days {
    day: "2026-03-11"
    day_number: "11"
    weekday_short: "Wed"
    heading: "Today"
    is_today: true
    is_past: false
    items {
      task {
        task_id: "task-0001"
        title: "Send the survey notes"
        check: TASKS_CHECK_OPEN
        check_label: "Mark Send the survey notes done"
        accessibility_label: "Send the survey notes"
        can_file: true
        can_check: true
      }
    }
    items {
      event {
        event_id: "event-0001"
        instance_key: "2026-03-11T08:15"
        original_start_local: "2026-03-11T08:15"
        row_key: "2026-03-11|2026-03-11T08:15"
        title: "Survey walk-through"
        time_label: "08:15 – 09:30"
        meta: "repeats · 2 guests"
        calendar_hue_key: "cTeal"
        status: AGENDA_ROW_STATUS_NEEDS_REPLY
        status_label: "needs a reply"
        accessibility_label: "Survey walk-through, 08:15 to 09:30, repeats, 2 guests, needs a reply"
        is_past: true
      }
    }
    items {
      now_line { label: "09:42" accessibility_label: "Now, 09:42" }
    }
    items {
      event {
        event_id: "event-0002"
        instance_key: "2026-03-11T14:00"
        row_key: "2026-03-11|2026-03-11T14:00"
        title: "Dentist"
        time_label: "14:00 – 14:45"
        meta: ""
        calendar_hue_key: "cPlum"
        status: AGENDA_ROW_STATUS_PENDING
        status_label: "pending"
        accessibility_label: "Dentist, 14:00 to 14:45, pending"
        is_past: false
      }
    }
  }
  empty: AGENDA_EMPTY_NONE
  calendars {
    calendar_id: "calendar-home"
    name: "Home"
    hue_key: "cTeal"
    hidden: false
    state_label: "Shown"
  }
  calendars {
    calendar_id: "calendar-health"
    name: "Health"
    hue_key: "cPlum"
    hidden: false
    state_label: "Shown"
  }
  waiting_count: 1
  event_count: 2
  event_count_label: "2 events"
  landing { day: "2026-03-11" now_line: true }
}
sheet: SHEET_NONE
band { key: "day" label: "Day" icon_key: "Clock" current: true }
band { key: "schedule" label: "Schedule" icon_key: "List" current: false }
band { key: "waiting" label: "Waiting" icon_key: "Inbox" current: false }
band { key: "todo" label: "To-do" icon_key: "Todo" current: false }
band { key: "more" label: "More" icon_key: "MoreHoriz" current: false }
toolbar {
  shown: true
  range_label: "Today"
  month_label: "March 2026"
  at_today: true
}
chrome {
  title: "Agenda"
  new_event: "New event"
  today: "Today"
  tasks { quick_add_placeholder: "Task name" quick_add_verb: "Add" file_verb: "Move to project" }
}
add_label: "New event"
add_opens_quick_add: false
pending_event_ids: "event-0002"
more_rows {
  key: "calendar-calendar-home"
  label: "Home"
  meta: "Shown"
  hue_key: "cTeal"
  toggle: true
  on: true
  section: "Calendars"
  spoken: "Home, Shown"
}
more_rows {
  key: "calendar-calendar-health"
  label: "Health"
  meta: "Shown"
  hue_key: "cPlum"
  toggle: true
  on: true
  spoken: "Health, Shown"
}
more_rows {
  key: "anytime"
  label: "Anytime"
  meta: "no date, still yours"
  section: "Tasks"
  spoken: "Anytime, no date, still yours"
  icon_key: "Layers"
}
more_rows {
  key: "logbook"
  label: "Logbook"
  meta: "done and won't do"
  spoken: "Logbook, done and won't do"
  icon_key: "Book"
}
more_rows {
  key: "reminders"
  label: "Reminders"
  meta: "open work with a reminder"
  spoken: "Reminders, open work with a reminder"
  icon_key: "Bell"
}
more_rows { key: "trash" label: "Trash" meta: "deleted tasks" spoken: "Trash, deleted tasks" icon_key: "Trash" }
more_rows { key: "reads" label: "What Agenda may read" spoken: "What Agenda may read" }
