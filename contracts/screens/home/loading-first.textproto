# THE SEED. Every app LOADING, in springboard order, before one read has landed.
#
# A read in flight holds its slot at full geometry, so every tile here has
# `earns_grid: true` — demoting and re-promoting a beat later is a relayout the
# member watches.
data {
  springboard: SPRINGBOARD_LOADING
  tiles { app_id: "photos" status: TILE_STATUS_LOADING size: TILE_SIZE_LARGE wide: true earns_grid: true empty_copy: "Import your first photo" }
  tiles { app_id: "docs" status: TILE_STATUS_LOADING size: TILE_SIZE_MEDIUM wide: true earns_grid: true empty_copy: "Add your first document" }
  tiles { app_id: "notes" status: TILE_STATUS_LOADING size: TILE_SIZE_MEDIUM wide: true earns_grid: true empty_copy: "Write your first note" }
  tiles { app_id: "agenda" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL earns_grid: true empty_copy: "Put something on the calendar" }
  tiles { app_id: "tasks" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL earns_grid: true empty_copy: "Capture the next thing to do" }
  tiles { app_id: "people" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL earns_grid: true empty_copy: "Add someone you know" }
  tiles { app_id: "tally" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL earns_grid: true empty_copy: "Log your first expense" }
  tiles { app_id: "locker" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL earns_grid: true empty_copy: "Unlock to see your items" }
  # NOT settled: nothing may render this total as final.
  things { total: 0 settled: false }
  status { tone: TONE_QUIET copy: "On this phone · pair a vault when ready" destination: DESTINATION_NONE }
  # THE PACKED GRID, decided by the machine so the two shells cannot pack it
  # differently. A wide tile takes a whole line; smalls pair. A lone small at
  # the end is not a hole.
  grid_rows { app_ids: "photos" }
  grid_rows { app_ids: "docs" }
  grid_rows { app_ids: "notes" }
  grid_rows { app_ids: "agenda" app_ids: "tasks" }
  grid_rows { app_ids: "people" app_ids: "tally" }
  grid_rows { app_ids: "locker" }
}
