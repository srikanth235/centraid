# THE SEED. Every app LOADING, in springboard order, before one read has landed.
#
# A read in flight holds its slot at full geometry, and every app is a tile
# whatever it holds — nothing is demoted and re-promoted a beat later, which
# would be a relayout the member watches.
data {
  springboard: SPRINGBOARD_LOADING
  tiles { app_id: "photos" status: TILE_STATUS_LOADING size: TILE_SIZE_LARGE wide: true empty_copy: "Import your first photo" }
  tiles { app_id: "docs" status: TILE_STATUS_LOADING size: TILE_SIZE_MEDIUM wide: true empty_copy: "Add your first document" }
  tiles { app_id: "notes" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL empty_copy: "Write your first note" }
  tiles { app_id: "agenda" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL empty_copy: "Put something on the calendar" }
  tiles { app_id: "tasks" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL empty_copy: "Capture the next thing to do" }
  tiles { app_id: "people" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL empty_copy: "Add someone you know" }
  tiles { app_id: "locker" status: TILE_STATUS_LOADING size: TILE_SIZE_SMALL empty_copy: "Unlock to see your items" }
  # NOT settled: nothing may render this total as final.
  status { tone: TONE_QUIET copy: "Not backed up yet" destination: DESTINATION_NONE }
  # THE PACKED GRID, decided by the machine so the two shells cannot pack it
  # differently. A wide tile takes a whole line; smalls pair. A lone small at
  # the end is not a hole.
  grid_rows { app_ids: "photos" }
  grid_rows { app_ids: "docs" }
  grid_rows { app_ids: "notes" app_ids: "agenda" }
  grid_rows { app_ids: "tasks" app_ids: "people" }
  grid_rows { app_ids: "locker" }
}
