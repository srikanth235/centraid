# TWO CURRENCIES: each is its own hero and its own table, and nothing is summed across them.
# The over-plan category reads as a minus sign and weight, with colour only the second channel.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
destination: DESTINATION_SPENDING
month: "2026-10"
data {
  today: "2026-10-14"
  month_label: "October 2026"
  shows_month: true
  spending {
    heroes {
      spent { minor: 331458 currency: "USD" exponent: 2 }
      spent_label: "spent"
      figures { label: "Planned" amount { minor: 378500 currency: "USD" exponent: 2 } tone: TONE_NEUTRAL }
      figures { label: "Left" amount { minor: 47042 currency: "USD" exponent: 2 } tone: TONE_NEUTRAL }
      has_bar: true
      fill_bp: 8757
      tick_bp: 4516
      accessibility_label: "87% of plan, day 14 of 31"
    }
    heroes {
      spent { minor: 12000 currency: "CAD" exponent: 2 }
      spent_label: "spent"
    }
    days_left_label: "17 days left"
    in_out_net {
      figures { label: "In" amount { minor: 245662 currency: "USD" exponent: 2 } tone: TONE_NEUTRAL }
      figures { label: "Out" amount { minor: 333808 currency: "USD" exponent: 2 } tone: TONE_NEUTRAL }
      figures { label: "Net" amount { minor: -88146 currency: "USD" exponent: 2 } tone: TONE_NET }
    }
    tables {
      currency: "USD"
      rows {
        category_id: "c-util"
        label: "Utilities"
        has_plan: true
        planned { minor: 22000 currency: "USD" exponent: 2 }
        spent { minor: 24827 currency: "USD" exponent: 2 }
        left { minor: -2827 currency: "USD" exponent: 2 }
        over: true
        accessibility_label: "Utilities, over plan"
      }
    }
    notes: "3 rows need a category"
    notes: "2 transfers are not counted"
    recurring_label: "Recurring charges"
    recurring_meta: "Steady charges found in your rows"
  }
}
sheet: SHEET_NONE
band { key: "spending" label: "Spending" icon_key: "Coin" current: true }
band { key: "activity" label: "Activity" icon_key: "List" current: false }
band { key: "cashflow" label: "Cash flow" icon_key: "BarChart2" current: false }
band { key: "more" label: "More" icon_key: "MoreHoriz" current: false }
chrome {
  title: "Money"
  add_label: "Import statement"
  retry: "Try again"
  more_title: "More"
  more_rows { key: "accounts" label: "Accounts" meta: "Balances and statement checks" icon_key: "Table" }
  more_rows { key: "rules" label: "Rules" meta: "Name and file rows" icon_key: "Filter" }
  more_rows { key: "categories" label: "Categories" meta: "Groups and categories" icon_key: "Tag" }
  more_rows { key: "import" label: "Import statement" meta: "CSV, OFX or QFX" icon_key: "Download" }
  search_placeholder: "Search transactions"
  previous_month_label: "Previous month"
  next_month_label: "Next month"
  month_sheet_title: "Month"
  account_sheet_title: "Account"
  category_sheet_title: "Category"
  close_label: "Close"
}
activity_shown: 50
