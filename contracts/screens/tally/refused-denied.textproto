# A REFUSED READ. `data` is absent and the failure carries the access plane's
# SENTENCE, never its predicate.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
destination: DESTINATION_BALANCES
failure {
  kind: READ_FAILURE_KIND_REFUSED
  sentence: "This is not shared with you."
}
