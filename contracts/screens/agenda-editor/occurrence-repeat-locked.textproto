# EDITING ONE OCCURRENCE OF A SERIES. A repeat rule is the whole series', so
# the repeat row is not enabled here and says why; skipping this one
# occurrence is offered instead.
seat {
  availability: AVAILABILITY_READY
  durability: DURABILITY_AUTHORITATIVE
  connectivity: CONNECTIVITY_ONLINE_UNMETERED
}
mode: MODE_EDIT
event_id: "event-0003"
instance_key: "2026-03-11T14:00"
original_start_local: "2026-03-11T14:00"
day: "2026-03-11"
data {
  draft {
    title: "Book club"
    all_day: false
    start_day: "2026-03-11"
    start_time: "14:00"
    end_day: "2026-03-11"
    end_time: "15:00"
    calendar_id: "calendar-home"
    repeat_key: "weekly"
    reminder_key: "none"
  }
  heading: "Edit this occurrence"
  start_label: "Wednesday 11 March · 14:00"
  end_label: "Wednesday 11 March · 15:00"
  calendar_label: "Home"
  calendar_hue_key: "cTeal"
  calendars { key: "calendar-home" label: "Home" selected: true hue_key: "cTeal" accessibility_label: "Home" }
  guests_label: "Nobody else"
  repeat_label: "Every week on Wednesday"
  repeats { key: "never" label: "Does not repeat" selected: false }
  repeats { key: "weekly" label: "Every week on Wednesday" selected: true }
  repeat_enabled: false
  repeat_note: "A repeat rule belongs to the whole series."
  reminder_label: "No reminder"
  reminders { key: "none" label: "No reminder" selected: true }
  dirty: false
  can_save: false
  blocked_reason: ""
  show_skip: true
  skip_label: "Skip this occurrence"
  foot_note: ""
  scope_armed: false
  start_day_label: "Wednesday 11 March"
  start_time_label: "14:00"
  end_day_label: "Wednesday 11 March"
  end_time_label: "15:00"
}
write { phase: PHASE_IDLE }
sheet: SHEET_NONE
asking: ASKING_NONE
chrome {
  title_placeholder: "Add a title"
  notes_placeholder: "Add notes"
  link_placeholder: "Paste a joining link"
  field_title: "Title"
  field_all_day: "All day"
  field_starts: "Starts"
  field_ends: "Ends"
  field_calendar: "Calendar"
  field_guests: "Guests"
