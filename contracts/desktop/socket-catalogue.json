{
  "local_protocol_version": 1,
  "statements": [
    {
      "name": "tally.vault",
      "statement": "tally.dashboard.vault",
      "select": ["vault_id", "self_party_id", "base_currency"],
      "from": "core_vault",
      "where": null,
      "binds": 0,
      "sort_column": "vault_id",
      "pk_column": "vault_id",
      "descending": false
    },
    {
      "name": "tally.friends",
      "statement": "tally.dashboard.friends",
      "select": ["friend_id", "party_id"],
      "from": "tally_friend",
      "where": null,
      "binds": 0,
      "sort_column": "friend_id",
      "pk_column": "friend_id",
      "descending": false
    },
    {
      "name": "tally.groups",
      "statement": "tally.dashboard.groups",
      "select": [
        "group_id",
        "circle_id",
        "icon",
        "color",
        "simplify_opt_in",
        "archived_at",
        "currency"
      ],
      "from": "tally_group",
      "where": null,
      "binds": 0,
      "sort_column": "group_id",
      "pk_column": "group_id",
      "descending": false
    },
    {
      "name": "tally.circles",
      "statement": "tally.dashboard.circles",
      "select": ["circle_id", "name"],
      "from": "social_circle",
      "where": null,
      "binds": 0,
      "sort_column": "circle_id",
      "pk_column": "circle_id",
      "descending": false
    },
    {
      "name": "tally.circleMembers",
      "statement": "tally.dashboard.circleMembers",
      "select": ["member_id", "circle_id", "party_id"],
      "from": "social_circle_member",
      "where": null,
      "binds": 0,
      "sort_column": "member_id",
      "pk_column": "member_id",
      "descending": false
    },
    {
      "name": "tally.expenses",
      "statement": "tally.dashboard.expenses",
      "select": [
        "expense_id",
        "group_id",
        "description",
        "amount_minor",
        "currency",
        "paid_by",
        "split_method",
        "split_params_json",
        "spent_on",
        "category",
        "txn_id",
        "created_at",
        "updated_at"
      ],
      "from": "tally_expense",
      "where": "deleted_at IS NULL",
      "binds": 0,
      "sort_column": "spent_on",
      "pk_column": "expense_id",
      "descending": true
    },
    {
      "name": "tally.splits",
      "statement": "tally.dashboard.splits",
      "select": ["expense_id", "party_id", "share_minor"],
      "from": "tally_expense_split",
      "where": null,
      "binds": 0,
      "sort_column": "expense_id",
      "pk_column": "party_id",
      "descending": false
    },
    {
      "name": "tally.payers",
      "statement": "tally.dashboard.payers",
      "select": ["expense_id", "party_id", "paid_minor"],
      "from": "tally_expense_payer",
      "where": null,
      "binds": 0,
      "sort_column": "expense_id",
      "pk_column": "party_id",
      "descending": false
    },
    {
      "name": "tally.settlements",
      "statement": "tally.dashboard.settlements",
      "select": [
        "settlement_id",
        "group_id",
        "from_party",
        "to_party",
        "amount_minor",
        "currency",
        "paid_on",
        "txn_id",
        "created_at"
      ],
      "from": "tally_settlement",
      "where": "deleted_at IS NULL",
      "binds": 0,
      "sort_column": "settlement_id",
      "pk_column": "settlement_id",
      "descending": false
    },
    {
      "name": "tally.obligations",
      "statement": "tally.dashboard.obligations",
      "select": [
        "obligation_id",
        "from_party",
        "to_party",
        "amount_minor",
        "currency",
        "reason",
        "incurred_on",
        "settled_at"
      ],
      "from": "tally_obligation",
      "where": "settled_at IS NULL AND deleted_at IS NULL",
      "binds": 0,
      "sort_column": "obligation_id",
      "pk_column": "obligation_id",
      "descending": false
    },
    {
      "name": "tally.receipts",
      "statement": "tally.dashboard.receipts",
      "select": [
        "attachment_id",
        "target_type",
        "target_id",
        "content_id",
        "role",
        "is_primary"
      ],
      "from": "core_attachment",
      "where": "target_type = ? AND role = ?",
      "binds": 2,
      "sort_column": "attachment_id",
      "pk_column": "attachment_id",
      "descending": false
    },
    {
      "name": "companion.apps",
      "statement": "companion.apps",
      "select": ["app_id", "name", "display_name", "label"],
      "from": "access_app",
      "where": null,
      "binds": 0,
      "sort_column": "app_id",
      "pk_column": "app_id",
      "descending": false
    },
    {
      "name": "companion.outbox",
      "statement": "companion.outbox",
      "select": ["item_id", "verb", "target", "staged_at"],
      "from": "outbox_item",
      "where": "status = ?",
      "binds": 1,
      "sort_column": "item_id",
      "pk_column": "item_id",
      "descending": false
    },
    {
      "name": "companion.connections",
      "statement": "companion.connections",
      "select": ["connection_id", "kind", "label"],
      "from": "sync_connection",
      "where": "status = ?",
      "binds": 1,
      "sort_column": "connection_id",
      "pk_column": "connection_id",
      "descending": false
    },
    {
      "name": "companion.parked",
      "statement": "companion.parked",
      "select": ["intent_id", "status"],
      "from": "replica_intent_outcome",
      "where": "status = ?",
      "binds": 1,
      "sort_column": "intent_id",
      "pk_column": "intent_id",
      "descending": false
    },
    {
      "name": "companion.scopeRequests",
      "statement": "companion.scopeRequests",
      "select": ["request_id", "principal_id", "requested_at"],
      "from": "share_authority_request",
      "where": "decided_at IS NULL",
      "binds": 0,
      "sort_column": "request_id",
      "pk_column": "request_id",
      "descending": false
    },
    {
      "name": "locker.autofillLogins",
      "statement": "locker.autofill.logins",
      "select": [
        "item_id",
        "type",
        "title",
        "username",
        "url",
        "url_match_policy",
        "notes",
        "cardholder",
        "expiry",
        "brand",
        "fullname",
        "email",
        "phone",
        "address",
        "network",
        "connection_id",
        "compromised",
        "password_set_at",
        "created_at",
        "updated_at",
        "archived_at",
        "deleted_at",
        "purge_at"
      ],
      "from": "locker_item",
      "where": "type = ? AND deleted_at IS NULL",
      "binds": 1,
      "sort_column": "updated_at",
      "pk_column": "item_id",
      "descending": true
    },
    {
      "name": "photos.assets",
      "statement": "photos.timeline.assets",
      "select": [
        "asset_id",
        "content_id",
        "kind",
        "title",
        "captured_at",
        "tz_offset_min",
        "width",
        "height",
        "duration_s",
        "created_at"
      ],
      "from": "media_asset",
      "where": "archived_at IS NULL AND deleted_at IS NULL",
      "binds": 0,
      "sort_column": "captured_at",
      "pk_column": "asset_id",
      "descending": true
    },
    {
      "name": "photos.content",
      "statement": "photos.timeline.content",
      "select": ["content_id", "sha256", "byte_size", "created_at"],
      "from": "core_content_item",
      "where": "deleted_at IS NULL",
      "binds": 0,
      "sort_column": "content_id",
      "pk_column": "content_id",
      "descending": false
    },
    {
      "name": "photos.representations",
      "statement": "photos.timeline.representations",
      "select": [
        "representation_id",
        "content_id",
        "media_type",
        "interpretation",
        "width",
        "height"
      ],
      "from": "core_content_representation",
      "where": null,
      "binds": 0,
      "sort_column": "representation_id",
      "pk_column": "representation_id",
      "descending": false
    }
  ]
}
