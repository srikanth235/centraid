{
  "name": "centraid-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Centraid — personal app builder for desktop, installable web, and mobile clients.",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "tools/*"
    ],
    "catalog": {
      "typescript": "5.9.3"
    }
  },
  "type": "module",
  "scripts": {
    "boot:smoke": "node scripts/release/boot-smoke.mjs",
    "build": "turbo run build",
    "check": "bun run check:fast",
    "check:diff-coverage": "node scripts/test-report/diff-coverage-run.mjs",
    "check:diff-coverage:full": "node scripts/test-report/diff-coverage-run.mjs --dependents",
    "check:fast": "bun run format:check && bun run lint && bun run typecheck:affected",
    "check:full": "bun run check:pr && bun run test:affected:full && bun run coverage && bun run test:mutation:pr && bun run test:perf:pr && bun run --cwd apps/desktop test:e2e && bun run --cwd apps/web e2e",
    "check:mobile-native-state": "node scripts/check-mobile-native-state.mjs",
    "check:pr": "bun install --frozen-lockfile && bun run check:push && bun run typecheck && bun run lint:types && bun run lint:workflow-pins && bun run check:diff-coverage",
    "check:push": "node scripts/ci/run-gates.mjs lint:node-version test:affected typecheck:affected knip format:check lint scripts:test test:ratchet:unit test:governance-shell lint:packages turbo:lint lint:tsconfigs test:matrix test:qualities test:ratchet lint:css lint:design-tokens lint:mobile-design lint:logical-insets lint:hairline lint:design-md design:gallery lint:e2e-flows lint:engine-conformance lint:law-registry lint:protocol-routes lint:acp-min-versions lint:aria-labels lint:container-opacity lint:type-floor lint:motion-rule lint:quality-knobs lint:schema-export check:ui-receipt test:quarantine test:accessibility test:report:smoke check:mobile-native-state lockfile:lint",
    "check:ui-receipt": "node scripts/validate-ui-receipt.mjs",
    "ci": "bun run check:pr",
    "ci:retry": "node scripts/ci/retry.mjs",
    "coverage": "node scripts/test-report/prepare.mjs --lane vitest && node node_modules/vitest/vitest.mjs run --coverage --reporter=default --reporter=json --outputFile=artifacts/test-results/vitest.json",
    "design:gallery": "bun scripts/design-gallery.mjs",
    "dev:desktop": "turbo run dev --filter=@centraid/desktop",
    "dev:mobile": "turbo run dev --filter=@centraid/mobile",
    "dev:web": "turbo run dev --filter=@centraid/web",
    "docs:build": "node scripts/docs-site/build.mjs",
    "docs:bundle": "DOCS_SITE_BASE_PATH=/docs node scripts/docs-site/build.mjs && bun install --cwd centraid-city --frozen-lockfile && bun run --cwd centraid-city build:site && node scripts/docs-site/assemble.mjs",
    "docs:serve": "python3 -m http.server 4173 --bind 127.0.0.1 -d dist/docs-site",
    "docs:smoke": "node scripts/docs-site/smoke.mjs",
    "format": "oxfmt -c oxfmt.config.ts --disable-nested-config --write .",
    "format:check": "oxfmt -c oxfmt.config.ts --disable-nested-config --check .",
    "gateway:install": "bash scripts/install-gateway.sh",
    "gateway:npm:helpers:test": "node --test scripts/gateway-npm/pack-helpers.test.mjs scripts/gateway-npm/native-platforms.test.mjs",
    "gateway:npm:merge-native": "node scripts/gateway-npm/merge-native-artifacts.mjs",
    "gateway:npm:pack": "node scripts/gateway-npm/pack.mjs",
    "gateway:npm:pack:dry": "node scripts/gateway-npm/pack.mjs --dry-run",
    "gateway:npm:publish": "node scripts/gateway-npm/publish.mjs",
    "gateway:package:assemble": "node scripts/gateway-package/assemble-runtime.mjs",
    "gateway:package:assemble:test": "node --test scripts/gateway-package/assemble-runtime.test.mjs",
    "gateway:package:probe:test": "node --test scripts/gateway-package/probe.test.mjs",
    "gateway:package:smoke": "node scripts/gateway-package/smoke.mjs",
    "gateway:package:trace": "node scripts/gateway-package/trace.mjs",
    "knip": "knip",
    "lint": "oxlint -c oxlint.config.ts --disable-nested-config --deny-warnings .",
    "lint:acp-min-versions": "node scripts/lint-acp-min-versions.mjs",
    "lint:actions": "actionlint",
    "lint:aria-labels": "node scripts/lint-aria-labels.mjs",
    "lint:container-opacity": "node scripts/lint-container-opacity.mjs",
    "lint:css": "node scripts/lint-css-classes.mjs",
    "lint:design-md": "design.md lint DESIGN.md",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:e2e-flows": "node scripts/lint-e2e-flows.mjs",
    "lint:engine-conformance": "node scripts/lint-engine-conformance.mjs",
    "lint:fix": "oxlint -c oxlint.config.ts --disable-nested-config --deny-warnings --fix .",
    "lint:hairline": "node scripts/lint-hairline.mjs",
    "lint:law-registry": "node scripts/lint-law-registry.mjs",
    "lint:logical-insets": "node scripts/lint-logical-insets.mjs",
    "lint:mobile-design": "node scripts/lint-mobile-design.mjs",
    "lint:motion-rule": "node scripts/lint-motion-rule.mjs",
    "lint:node-version": "node scripts/ci/node-version.mjs",
    "lint:packages": "sherif",
    "lint:protocol-routes": "node scripts/lint-protocol-routes.mjs",
    "lint:quality-knobs": "node scripts/check-quality-knobs.mjs",
    "lint:schema-export": "node scripts/check-schema-export-ratchet.mjs",
    "lint:tsconfigs": "node scripts/lint-tsconfigs.mjs",
    "lint:type-floor": "node scripts/lint-type-floor.mjs",
    "lint:types": "bash scripts/lint-types.sh",
    "lint:workflow-pins": "node scripts/lint-workflow-pins.mjs",
    "lockfile:lint": "node scripts/ci/lockfile-lint.mjs",
    "perf:app-weight": "node scripts/perf/app-weight.mjs",
    "perf:gateway": "turbo run build --filter=@centraid/gateway && bun run --cwd packages/gateway perf:low-end",
    "perf:runtime-probe": "node packages/gateway/scripts/probe-runtime-sqlite.mjs",
    "release:classify": "node scripts/release/classify.mjs",
    "release:matrix": "node scripts/release/matrix.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:restamp": "node scripts/release/restamp-rollout.mjs",
    "release:surfaces:test": "node --test scripts/release/surfaces.test.mjs",
    "release:sync-versions": "node scripts/release/sync-versions.mjs",
    "release:verify-secrets": "node scripts/release/verify-secrets.mjs",
    "scripts:test": "node node_modules/vitest/vitest.mjs run --config scripts/release/vitest.config.ts && bun run release:surfaces:test && node --test scripts/lib/sanitize-connector-svg.test.mjs scripts/lint-design-tokens.test.mjs scripts/lint-mobile-design.test.mjs scripts/lint-logical-insets.test.mjs scripts/lint-hairline.test.mjs scripts/lint-workflow-pins.test.mjs scripts/ci/file-tracking-issue.test.mjs scripts/ci/run-slug.test.mjs scripts/ci/hygiene-gates.test.mjs scripts/ci/osv-lockfile-scan.test.mjs scripts/lint-e2e-flows.test.mjs scripts/lint-tsconfigs.test.mjs scripts/lint-css-classes.test.mjs scripts/lint-protocol-routes.test.mjs scripts/lint-law-registry.test.mjs scripts/lint-engine-conformance.test.mjs scripts/check-mobile-native-state.test.mjs",
    "test": "turbo run test && node scripts/test-report/report-floors.mjs",
    "test:accessibility": "node --test scripts/accessibility-contract.test.mjs",
    "test:affected": "turbo run test --filter='[origin/main]' --concurrency=6",
    "test:affected:full": "turbo run test --filter='...[origin/main]' --concurrency=6",
    "test:diff-coverage": "node scripts/test-report/diff-coverage.mjs",
    "test:enrich:live": "node scripts/test-report/enrichment-live-run.mjs",
    "test:governance-shell": "bash scripts/test.sh",
    "test:interop:backup": "bun run --cwd packages/backup test:interop",
    "test:matrix": "node scripts/test-report/validate-matrix.mjs && node scripts/test-report/validate-nightly-wiring.mjs && node scripts/test-report/validate-release-wiring.mjs",
    "test:mutation": "node scripts/mutation/run.mjs",
    "test:mutation:pr": "node scripts/mutation/run.mjs --affected --enforce-floors",
    "test:perf": "node scripts/test-report/prepare.mjs --lane perf && node node_modules/vitest/vitest.mjs run --config vitest.perf.config.ts",
    "test:perf:pr": "bun run --cwd packages/gateway perf:low-end",
    "test:qualities": "node node_modules/vitest/vitest.mjs run --config vitest.quality.config.ts",
    "test:quality:nightly": "bun run test:perf && bun run test:scale && bun run test:report",
    "test:quarantine": "node scripts/test-report/quarantine.mjs",
    "test:ratchet": "node scripts/test-report/ratchet-floors.mjs && node scripts/test-report/skip-inventory.mjs",
    "test:ratchet:unit": "node node_modules/vitest/vitest.mjs run --config scripts/test-report/vitest.config.ts --coverage",
    "test:report": "node scripts/test-report/generate.mjs",
    "test:report:smoke": "node scripts/test-report/smoke.mjs",
    "test:scale": "node scripts/test-report/prepare.mjs --lane scale && node node_modules/vitest/vitest.mjs run --config vitest.scale.config.ts",
    "test:suite-wall-clock": "node scripts/test-report/suite-wall-clock.mjs",
    "toolchain:doctor": "ultracite doctor",
    "turbo": "turbo",
    "turbo:lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p tests",
    "typecheck:affected": "turbo run typecheck --filter='[origin/main]' && tsc -p tests",
    "web:build": "turbo run build --filter=@centraid/web",
    "web:smoke": "node scripts/web/smoke.mjs"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "^7.1.5",
    "jsdom": "30.0.0",
    "knip": "6.29.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pagefind": "^1.5.2",
    "playwright": "1.62.0",
    "pngjs": "7.0.0",
    "sherif": "^1.13.0",
    "turbo": "2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "shell-quote": "1.8.4",
    "tar": "7.5.22"
  },
  "engines": {
    "node": "24.4.1"
  },
  "packageManager": "bun@1.3.13",
  "op-sqlite": {
    "fts5": true,
    "sqliteVec": true
  }
}
