{
  "name": "@centraid/companion",
  "version": "0.1.0",
  "private": true,
  "description": "The Centraid browser Companion: MV3 over native messaging to the app on this machine. No network, no WASM.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "e2e": "../node_modules/.bin/playwright test -c \"$PWD/e2e/playwright.config.ts\"",
    "lint": "node scripts/lint.mjs",
    "round-trip": "node scripts/native-round-trip.mjs",
    "test": "vitest run --config ../desktop/vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  }
}
