<?xml version="1.0" encoding="utf-8"?>
<!-- Reminders, 4x2 (#1173): the header with the New Reminder button, then up to four
     rows. The button opens the app on its add-a-reminder action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glance_card"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/glance_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/centraid_text_group" android:textStyle="bold" android:textColor="@color/centraid_app_reminders_text" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/glance_today" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_group" android:textColor="@color/centraid_text_meta" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/glance_add" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/glance_pill" android:drawableStart="@drawable/glance_plus" android:drawablePadding="6dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="14dp" android:textSize="@dimen/centraid_text_meta" android:textStyle="bold" android:textColor="@color/centraid_surface_card" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/glance_row_0" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/glance_ring" android:importantForAccessibility="no" />
        <TextView android:id="@+id/glance_row_title_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="@dimen/centraid_text_row" android:textColor="@color/centraid_text_ink" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/glance_row_flag_0" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="8dp" android:src="@drawable/glance_flag" android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/glance_row_due_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textColor="@color/centraid_text_meta" android:maxLines="1" />
        <TextView android:id="@+id/glance_row_due_red_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textStyle="bold" android:textColor="@color/centraid_state_red_text" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/glance_row_1" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/glance_ring" android:importantForAccessibility="no" />
        <TextView android:id="@+id/glance_row_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="@dimen/centraid_text_row" android:textColor="@color/centraid_text_ink" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/glance_row_flag_1" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="8dp" android:src="@drawable/glance_flag" android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/glance_row_due_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textColor="@color/centraid_text_meta" android:maxLines="1" />
        <TextView android:id="@+id/glance_row_due_red_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textStyle="bold" android:textColor="@color/centraid_state_red_text" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/glance_row_2" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/glance_ring" android:importantForAccessibility="no" />
        <TextView android:id="@+id/glance_row_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="@dimen/centraid_text_row" android:textColor="@color/centraid_text_ink" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/glance_row_flag_2" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="8dp" android:src="@drawable/glance_flag" android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/glance_row_due_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textColor="@color/centraid_text_meta" android:maxLines="1" />
        <TextView android:id="@+id/glance_row_due_red_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textStyle="bold" android:textColor="@color/centraid_state_red_text" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/glance_row_3" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/glance_ring" android:importantForAccessibility="no" />
        <TextView android:id="@+id/glance_row_title_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="@dimen/centraid_text_row" android:textColor="@color/centraid_text_ink" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/glance_row_flag_3" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="8dp" android:src="@drawable/glance_flag" android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/glance_row_due_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textColor="@color/centraid_text_meta" android:maxLines="1" />
        <TextView android:id="@+id/glance_row_due_red_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="@dimen/centraid_text_meta" android:textStyle="bold" android:textColor="@color/centraid_state_red_text" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/glance_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/centraid_text_row" android:textStyle="bold" android:textColor="@color/centraid_text_ink" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
