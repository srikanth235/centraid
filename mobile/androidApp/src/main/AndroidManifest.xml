<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android manifest, as SOURCE (#1020, D-1020-E1).

  The privacy rules are here, reviewable, and not the output of a build plugin.

  `android:allowBackup="false"` and the two rule files are the same three
  mechanisms v0's plugin wrote, and they are all three needed: `allowBackup`
  covers the legacy path, `dataExtractionRules` covers Android 12+ cloud backup
  and device-to-device transfer separately, and `fullBackupContent` covers the
  11-and-below fallback.

  `android:usesCleartextTraffic="false"` is stated because the platform default
  is `true` below API 28 and `minSdk` is 24. Nothing here speaks plain HTTP: a
  gateway is reached by the Rust core over HTTPS, pinned to the certificate the
  pairing QR fingerprinted (#1080 ruling 1), and the player reads local files,
  so the flag costs nothing and closes the old-device default.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HEALTH CONNECT'S CLIENT SAYS minSdk 26; THE APP STAYS AT 24 (#1129).
         The floor is an owner setting, so it does not move for one library:
         the library is admitted below its floor here, and nothing touches a
         class of it below API 26 or while Health Connect is not available
         (`kit/HealthConnectReader.kt`, `HealthConnectAccess`). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- Photos, for the camera-roll backup only. The grid reads the VAULT and
         needs none of these. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- A photograph's place, as the camera wrote it (#1080, the walker).
         Without this grant Android 10 and up strips the EXIF location from
         every original it hands over, so the backup would hold a different
         file from the one the member took. Asked for with the photo grant
         (`PhotoAccessRemedy`); a reader then asks for the unredacted bytes
         with `MediaStore.setRequireOriginal`. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- The camera, for pair.laptop's scan of the laptop's square only
         (#1047 E6), asked for when the member taps Scan. Declaring it means
         Docs' Scan capture intent needs the grant too, so Docs asks for it
         the same way (`DocsRoutes`). Not required: a phone without a camera
         pairs by paste and hides Scan. -->
    <!-- Dictating a question to Chat: the microphone, listened to by the phone's own on-device
         recogniser, never a service. Asked at the first tap on the key, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Contacts, for People's one-tap import only: asked for when the member taps
         "Import contacts" on People's day-one empty state, never at launch
         (`screens/people/ContactsImporter.kt`). Read once, written into the
         member's vault as their own people; nothing is synced back. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Calendar, for Agenda's calendar follow: asked for when the member taps
         "Import calendar" on Agenda's day one, never at launch
         (`screens/agenda/CalendarImporter.kt`). Read only: the phone's events are
         copied into the member's vault and nothing is written back. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Health, READ ONLY (#1129, R-1129-7): Health Connect's daily totals
         and workouts, asked for when the member taps Connect on Health's
         Connect page and for exactly the types chosen there, never at launch
         (`kit/ScreenEffects.kt`). No WRITE_ permission is ever
         declared: nothing is written back (`HealthConnectReadOnlySpec`). The
         last three are a workout's figures; READ_HEALTH_DATA_HISTORY lets the
         first read reach the year it keeps, not only the 30 days before the
         grant. READ_HEALTH_DATA_IN_BACKGROUND (D16) lets the background
         window read Health while Centraid is closed; it is asked in the same
         sheet, at the Connect tap and nowhere else. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- FINDING A GATEWAY THAT MOVED (#1080 Q-1080-D3, #1152; `session/NsdBrowse.kt`).
         A normal permission, so nothing is asked of the member. Many handsets drop
         the replies to an mDNS question unless an app holds a multicast lock, so
         the browse holds one for exactly the seconds a window runs. The phone only
         asks and reads: it registers no service and opens no listening socket. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- "BACK UP NOW" AND A BACKLOG (#1080, the shells; `backup/BackupNow.kt`).
         API 34 and up: a user-initiated data transfer job, which needs
         RUN_USER_INITIATED_JOBS. Below 34: a `dataSync` foreground service,
         which needs FOREGROUND_SERVICE and, from 34, its typed twin. Both show
         a notification, which needs POST_NOTIFICATIONS from 33 — asked for
         when the member taps "Back up now", never at launch. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AGENDA'S REMINDERS AND ALERTS (#1173; `notify/Notify.kt`). POST_NOTIFICATIONS
         above is asked for at the first reminder that would fire (never at launch).
         SCHEDULE_EXACT_ALARM and NOT USE_EXACT_ALARM: Play restricts USE_EXACT_ALARM to
         apps whose core function is an alarm clock or a calendar, and Centraid is a
         vault whose Agenda is one app among many, so claiming it risks the listing.
         SCHEDULE_EXACT_ALARM is a user-revocable grant (on by default on 31 and 32, off
         on 33 and up); when it is not held the reminder is set inexact, a few minutes
         late at worst, and the member is never sent to settings for it. The boot
         receiver re-arms every alarm a reboot cleared. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- WHAT HEALTH ASKS THE PACKAGE MANAGER ABOUT (#1129): Health Connect
         itself (Android 9 to 13, where it is an app), and the apps that write
         to it — each declares one of the two rationale intents below — so a
         workout says which app recorded it by that app's name. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <application
        android:name=".CentraidApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="Centraid"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Centraid"
        android:usesCleartextTraffic="false">
        <!-- Compose handles appearance changes in place so the open route and draft survive. -->
        <activity
            android:name="dev.centraid.android.MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "ADD A REMINDER" AND A WIDGET'S TAPS (#1173): the launcher's long-press shortcuts
                 send `dev.centraid.action.ADD_REMINDER` ("What's next" sends AGENDA_OPEN with no key) and a widget's rows, body and button send
                 `dev.centraid.action.AGENDA_OPEN` with one opaque key, both aimed at this activity,
                 which hands them to the core (`glance/AgendaIntents.kt`). There is no filter for
                 them, but the activity is exported, so ANY app may send either: nothing here is
                 trusted. The core opens only a page the snapshot's own table names for that key,
                 and Agenda's home for any other, and an add writes nothing until the member taps
                 Add. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- AGENDA'S TWO HOME-SCREEN WIDGETS (#1173). Framework providers over RemoteViews
             (`glance/`): they draw the one snapshot file Rust's `agenda.glance` service keeps
             (`filesDir/agenda-glance.json`) and never open the vault. Exported because the launcher
             binds a widget's provider; the only broadcasts they act on are the platform's update and
             the app's own redraw request, and both only redraw what is already on disk. The label
             and the description come from the generated strings, which the launcher reads before any
             code runs. Privacy ruling: titles never show on a locked phone, so both providers are
             `home_screen` only (never `keyguard`) and the app adds no lock-screen surface. -->
        <receiver
            android:name="dev.centraid.android.glance.UpNextWidget"
            android:exported="true"
            android:label="@string/glance_widget_up_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_up_next_info" />
        </receiver>
        <receiver
            android:name="dev.centraid.android.glance.RemindersWidget"
            android:exported="true"
            android:label="@string/glance_widget_reminders_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_reminders_info" />
        </receiver>
        <!-- HEALTH'S HOME-SCREEN WIDGET (#1185): the same kind of provider, drawing
             `filesDir/health-glance.json` (Rust's `health.glance` service) and never opening the
             vault. `home_screen` only, never `keyguard`; a tap sends
             `dev.centraid.action.HEALTH_OPEN` with one opaque key to this app's activity
             (`glance/HealthIntents.kt`). -->
        <receiver
            android:name="dev.centraid.android.glance.HealthWidget"
            android:exported="true"
            android:label="@string/glance_widget_health_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_health_info" />
        </receiver>

        <!-- "WHAT HEALTH MAY READ" FOR HEALTH CONNECT (#1129). Health Connect
             shows an app's permissions only when it declares where its
             rationale lives: the activity's own action on Android 13 and
             below, and the alias's VIEW_PERMISSION_USAGE in the
             HEALTH_PERMISSIONS category, guarded by the system's own
             permission, on 14 and up. Both open Health's own words
             (`HealthRationaleActivity`); neither reads or writes anything. -->
        <activity
            android:name="dev.centraid.android.screens.health.HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="dev.centraid.android.screens.health.HealthPermissionUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="dev.centraid.android.screens.health.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- THE TWO WAYS "BACK UP NOW" KEEPS THE PROCESS ALIVE (#1080). Neither
             is exported: the job is bound only by the system's job scheduler,
             and the service is started only by this app. -->
        <service
            android:name="dev.centraid.android.backup.BackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="dev.centraid.android.backup.BackupForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- AGENDA'S NOTIFICATIONS (#1173). None is exported. The boot receiver hears
             the system's own broadcasts (reboot, a new time or zone, this app updated,
             the exact-alarm grant changing) and re-arms every recorded alarm. -->
        <receiver
            android:name="dev.centraid.android.notify.NotifyAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.centraid.android.notify.NotifyActionReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.centraid.android.notify.NotifyBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- "Send a copy" (#816): the copies `PhotoHandOff` writes, and
             nothing else. Not exported; a receiving app reads one copy
             through the grant on the intent that carried it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photocopies"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_copies" />
        </provider>

        <!-- Docs' Scan row (#1047): the system camera app writes its
             photograph into `docs-scans/` through this, and nothing else.
             Not exported; the grant rides the capture intent. CAMERA is
             declared (pairing's scan), so the capture intent needs the grant
             and Docs asks for it at Scan. -->
        <provider
            android:name="dev.centraid.android.screens.docs.DocsScanProvider"
            android:authorities="${applicationId}.docsscans"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/docs_scans" />
        </provider>
    </application>
</manifest>
