<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android manifest, as SOURCE (#1020, D-1020-E1).

  The privacy rules are here, reviewable, and not the output of a build plugin.

  `android:allowBackup="false"` and the two rule files are the same three
  mechanisms v0's plugin wrote, and they are all three needed: `allowBackup`
  covers the legacy path, `dataExtractionRules` covers Android 12+ cloud backup
  and device-to-device transfer separately, and `fullBackupContent` covers the
  11-and-below fallback.

  `android:usesCleartextTraffic="false"` is stated because the platform default
  is `true` below API 28 and `minSdk` is 24. Nothing here speaks plain HTTP: a
  gateway is reached by the Rust core over HTTPS, pinned to the certificate the
  pairing QR fingerprinted (#1080 ruling 1), and the player reads local files,
  so the flag costs nothing and closes the old-device default.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HEALTH CONNECT'S CLIENT SAYS minSdk 26; THE APP STAYS AT 24 (#1129).
         The floor is an owner setting, so it does not move for one library:
         the library is admitted below its floor here, and nothing touches a
         class of it below API 26 or while Health Connect is not available
         (`kit/HealthConnectReader.kt`, `HealthConnectAccess`). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- Photos, for the camera-roll backup only. The grid reads the VAULT and
         needs none of these. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- A photograph's place, as the camera wrote it (#1080, the walker).
         Without this grant Android 10 and up strips the EXIF location from
         every original it hands over, so the backup would hold a different
         file from the one the member took. Asked for with the photo grant
         (`PhotoAccessRemedy`); a reader then asks for the unredacted bytes
         with `MediaStore.setRequireOriginal`. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- The camera, for pair.laptop's scan of the laptop's square only
         (#1047 E6), asked for when the member taps Scan. Declaring it means
         Docs' Scan capture intent needs the grant too, so Docs asks for it
         the same way (`DocsRoutes`). Not required: a phone without a camera
         pairs by paste and hides Scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Contacts, for People's one-tap import only (docs/decisions.md,
         "Onboarding without sample data"): asked for when the member taps
         "Import contacts" on People's day-one empty state, never at launch
         (`screens/people/ContactsImporter.kt`). Read once, written into the
         member's vault as their own people; nothing is synced back. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Calendar, for Agenda's one-tap import only (docs/decisions.md,
         "Onboarding without sample data"): asked for when the member taps
         "Import calendar" on Agenda's day one, never at launch
         (`screens/agenda/CalendarImporter.kt`). The window's occurrences are
         read once and written into the member's vault as their own events;
         nothing is synced back. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Health, READ ONLY (#1129, R-1129-7): Health Connect's daily totals
         and workouts, asked for when the member taps Connect on Health's
         Connect page and for exactly the types chosen there, never at launch
         (`screens/health/HealthConnectAct.kt`). No WRITE_ permission is ever
         declared: nothing is written back (`HealthConnectReadOnlySpec`). The
         last three are a workout's figures; READ_HEALTH_DATA_HISTORY lets the
         first read reach the year it keeps, not only the 30 days before the
         grant. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "BACK UP NOW" AND A BACKLOG (#1080, the shells; `backup/BackupNow.kt`).
         API 34 and up: a user-initiated data transfer job, which needs
         RUN_USER_INITIATED_JOBS. Below 34: a `dataSync` foreground service,
         which needs FOREGROUND_SERVICE and, from 34, its typed twin. Both show
         a notification, which needs POST_NOTIFICATIONS from 33 — asked for
         when the member taps "Back up now", never at launch. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WHAT HEALTH ASKS THE PACKAGE MANAGER ABOUT (#1129): Health Connect
         itself (Android 9 to 13, where it is an app), and the apps that write
         to it — each declares one of the two rationale intents below — so a
         workout says which app recorded it by that app's name. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <application
        android:name=".CentraidApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="Centraid"
        android:supportsRtl="true"
        android:theme="@style/Theme.Centraid"
        android:usesCleartextTraffic="false">
        <activity
            android:name="dev.centraid.android.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "WHAT HEALTH MAY READ" FOR HEALTH CONNECT (#1129). Health Connect
             shows an app's permissions only when it declares where its
             rationale lives: the activity's own action on Android 13 and
             below, and the alias's VIEW_PERMISSION_USAGE in the
             HEALTH_PERMISSIONS category, guarded by the system's own
             permission, on 14 and up. Both open Health's own words
             (`HealthRationaleActivity`); neither reads or writes anything. -->
        <activity
            android:name="dev.centraid.android.screens.health.HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="dev.centraid.android.screens.health.HealthPermissionUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="dev.centraid.android.screens.health.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- THE TWO WAYS "BACK UP NOW" KEEPS THE PROCESS ALIVE (#1080). Neither
             is exported: the job is bound only by the system's job scheduler,
             and the service is started only by this app. -->
        <service
            android:name="dev.centraid.android.backup.BackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="dev.centraid.android.backup.BackupForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- "Send a copy" (#816): the copies `PhotoHandOff` writes, and
             nothing else. Not exported; a receiving app reads one copy
             through the grant on the intent that carried it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photocopies"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_copies" />
        </provider>

        <!-- Docs' Scan row (#1047): the system camera app writes its
             photograph into `docs-scans/` through this, and nothing else.
             Not exported; the grant rides the capture intent. CAMERA is
             declared (pairing's scan), so the capture intent needs the grant
             and Docs asks for it at Scan. -->
        <provider
            android:name="dev.centraid.android.screens.docs.DocsScanProvider"
            android:authorities="${applicationId}.docsscans"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/docs_scans" />
        </provider>
    </application>
</manifest>
