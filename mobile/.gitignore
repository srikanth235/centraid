# Gradle's outputs. `mobile/` is source; `build/` and `.gradle/` are not.
build/
.gradle/
# Kotlin 2.x's per-project daemon state (session files and error logs).
.kotlin/
local.properties
# XcodeGen's output: `project.yml` is the source, `*.xcodeproj` is generated
# and never committed.
*.xcodeproj/
# `protoc-gen-swift` output. `crates/api-proto/proto` is the source; these are
# generated by the command in `mobile/README.md` -> "The iOS hand-off".
iosApp/Sources/Generated/
# SwiftPM's outputs for the local package.
iosApp/.build/
iosApp/Package.resolved

# THE DEMO VAULT IS A GENERATED ARTIFACT, and it has a generator.
#
# `cargo run -p centraid --bin seed-demo-vault` writes it and
# `mobile/scripts/demo-vault.sh` places it on a simulator and an emulator. It is
# 3.7 MB of SQLite and it changes every time the scenario's "now" moves, so a
# committed copy would be a binary nobody can review churning in every diff —
# and a fixture whose generator is one command does not need one.
# Two of them, because the vault switcher is only testable against two.
androidApp/src/main/assets/*-vault.db
iosApp/Resources/*-vault.db

# THE CROSS-COMPILED CORE IS A BUILD OUTPUT, and it has a builder.
#
# `mobile/scripts/android-core.sh` cross-compiles `centraid-core-ffi` for the
# device's ABI and drops it here. 32 MB of debug `.so` per ABI is not a thing to
# commit; the release lane builds its own.
androidApp/src/main/jniLibs/
