  "actions": [
    {
      "name": "add-account",
      "description": "Add an account the member imports statements into, with its currency, type, (optionally) an opening balance and the bank's own account number.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "external_ref": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "on_budget": {
            "type": "boolean"
          },
          "opening_minor": {
            "type": "integer"
          },
          "title": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": ["checking", "savings", "credit_card", "cash"]
          }
        },
        "required": ["title", "type"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "edit-account",
      "description": "Rename an account, change its type (checking and savings are one class), move it on or off budget, or set or clear the bank's account number.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "external_ref": {
            "maxLength": 64,
            "minLength": 1,
            "type": ["string", "null"]
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "on_budget": {
            "type": "boolean"
          },
          "title": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": ["checking", "savings", "credit_card", "cash"]
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "close-account",
      "description": "Close an account: it is marked archived, keeps every line, and leaves net worth. Send flag `archived`.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "flag": {
            "enum": ["starred", "pinned", "archived"],
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "flag"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "reopen-account",
      "description": "Reopen a closed account. Send flag `archived`.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "flag": {
            "enum": ["starred", "pinned", "archived"],
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "flag"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "set-opening-balance",
      "description": "State where an account stood before its first line; every balance after it is derived from that.",
      "confirmation": "required",
      "input": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "opening_minor": {
            "type": "integer"
          }
        },
        "required": ["id", "opening_minor"],
        "type": "object"
