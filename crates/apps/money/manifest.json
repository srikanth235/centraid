            "minLength": 1,
            "type": "string"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "month": {
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "type": "string"
          }
        },
        "required": ["month", "category_id", "amount_minor"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
