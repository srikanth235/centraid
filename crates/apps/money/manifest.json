          "ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 2000,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["ids", "category_id"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "void-transaction",
