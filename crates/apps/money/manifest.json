      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "import-transactions",
      "description": "Write the new lines of a statement the member reviewed: a line already in the account is left as it is (a line is never edited, and the member's category and name survive), so importing the same file twice writes nothing.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "origin": {
            "additionalProperties": false,
            "properties": {
              "config": {
                "type": ["object", "null"]
              },
              "device_id": {
                "type": ["string", "null"]
              },
              "fills": {
                "type": ["string", "null"]
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": ["ref", "label"],
            "type": "object"
          },
          "records": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "device_id": {
                  "type": ["string", "null"]
                },
                "external_id": {
                  "type": "string"
                },
                "fields": {
                  "type": "object"
                }
              },
              "required": ["external_id", "fields"],
              "type": "object"
            },
            "type": "array"
          },
          "since": {
            "type": "string"
          }
        },
        "required": ["origin", "records"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "record-checkpoint",
      "description": "Record a balance the bank stated on a day; a derived balance is compared with it.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "minLength": 1,
            "type": "string"
          },
          "balance_minor": {
            "type": "integer"
          },
          "day": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          }
        },
        "required": ["account_id", "day", "balance_minor"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "save-import-profile",
      "description": "Remember how this account's CSV statements are laid out, so the next one needs no questions.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "layout": {
            "additionalProperties": false,
            "properties": {
              "amount_col": {
                "minimum": 0,
                "type": ["integer", "null"]
              },
              "credit_col": {
                "minimum": 0,
                "type": ["integer", "null"]
              },
              "date_col": {
                "minimum": 0,
                "type": "integer"
              },
              "date_order": {
                "enum": ["mdy", "dmy", "ymd"]
              },
              "debit_col": {
                "minimum": 0,
                "type": ["integer", "null"]
              },
              "delimiter": {
                "maxLength": 1,
                "minLength": 1,
                "type": "string"
              },
              "desc_col": {
                "minimum": 0,
                "type": "integer"
              },
              "header_fingerprint": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "indicator_col": {
                "minimum": 0,
                "type": ["integer", "null"]
              },
              "indicator_out_value": {
                "type": ["string", "null"]
              },
              "memo_col": {
                "minimum": 0,
                "type": ["integer", "null"]
              },
              "sign_mode": {
                "enum": ["signed", "debit_credit", "indicator", "flip"]
              },
              "skip_lines": {
                "maximum": 1000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "header_fingerprint",
              "delimiter",
              "date_order",
              "sign_mode",
              "date_col",
              "desc_col"
            ],
            "type": "object"
          }
        },
        "required": ["id", "layout"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "categorize",
