{
  "manifestVersion": 1,
  "id": "tasks",
  "name": "Tasks",
  "description": "A Todoist-depth task manager as a projection of the personal vault: canonical tasks from the vault's own tasks, nothing stored here. Adding, completing and editing all run through typed task commands — consent-checked, contract-checked and journalled. Revoke the grant and the app goes dark while the tasks and their history remain the owner's.",
  "version": "0.4.0",
  "iconKey": "Check",
  "colorKey": "ochre",
  "vault": {
    "why": "Shows and manages your canonical task list.",
    "scopes": [
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "task",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "container",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "edge",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "document",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "photo",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "blob",
        "verbs": "read"
      },
      {
        "schema": "task",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "edit",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "complete",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "reopen",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "cancel",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "organize",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "trash",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "purge",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "restore",
        "verbs": "act"
      },
      {
        "schema": "container",
        "table": "create",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "remove",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "remove",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "add",
      "verb": "create",
      "kind": "task",
      "inverse": "delete",
      "sealed": [],
      "chat": "direct",
      "command": "task.add",
      "phrasings": [
        "remind me to call the plumber tomorrow",
        "add a task to buy milk",
        "put 'file taxes' on my list for April 15"
      ],
      "description": "Add a task through task.add: dated, prioritized, estimated, repeating, reminded, filed in a project and section, or as a subtask of an open top-level task.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "due": {
            "type": ["string", "null"],
            "description": "A day, a wall clock or an instant."
          },
          "effort_min": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "remind_before_min": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand, and a repeating task needs a due date."
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "parent_id": {
            "type": ["string", "null"]
          },
          "project_id": {
            "type": ["string", "null"]
          },
          "section_id": {
            "type": ["string", "null"]
          },
          "anchor": {
            "type": "string",
            "enum": ["scheduled", "completion"]
          },
          "zone": {
            "type": ["string", "null"]
          },
          "position": {
            "type": "number"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "edit",
      "verb": "edit",
      "kind": "task",
      "also": ["reschedule"],
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "task.edit",
      "phrasings": [
        "rename the plumber task",
        "make buying milk high priority",
        "add a note to the taxes task"
      ],
      "description": "Edit a task's title, note, due date, priority, effort, reminder lead time or repeat rule through task.edit. A key that is present is set (null clears it); a key that is absent is left alone.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "due": {
            "type": ["string", "null"],
            "description": "A day, a wall clock or an instant."
          },
          "effort_min": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "remind_before_min": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand, and a repeating task needs a due date."
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "complete",
      "verb": "complete",
      "kind": "task",
      "inverse": "reopen",
      "sealed": [],
      "chat": "direct",
      "command": "task.complete",
      "phrasings": [
        "mark call the plumber done",
        "I finished the taxes",
        "check off buy milk"
      ],
      "description": "Complete a task through task.complete: the one completion operation Tasks, People and automations share. A repeating task gets its next occurrence, carrying its project, tags and what it is about; completing a completed task changes nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "reopen",
      "verb": "reopen",
      "kind": "task",
      "inverse": "complete",
      "sealed": [],
      "chat": "direct",
      "command": "task.reopen",
      "phrasings": [
        "reopen call the plumber",
        "the taxes aren't done after all",
        "uncheck buy milk"
      ],
      "description": "Reopen a completed or cancelled task through task.reopen; it spawns nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "cancel",
      "verb": "cancel",
      "kind": "task",
      "inverse": null,
      "sealed": [],
      "chat": "card",
      "command": "task.cancel",
      "phrasings": [
        "cancel the plumber task",
        "I'm not buying milk anymore, drop it",
        "cancel this week's repeat of the laundry task"
      ],
      "description": "Cancel a task through task.cancel: it ends this occurrence with no successor (the Logbook's Won't do).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "organize-task",
      "verb": "add_to",
      "kind": "task",
      "also": ["remove_from"],
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "task.organize",
      "phrasings": [
        "put the plumber task in the Home project",
        "file buy milk under Errands",
        "move the taxes task to the Finance project"
      ],
      "description": "File a task through task.organize: its project and section (null is the Inbox), its place in the list, and what a repeat counts from. Moving to another project leaves the section behind unless one is named.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": ["string", "null"]
          },
          "section_id": {
            "type": ["string", "null"]
          },
          "position": {
            "type": "number"
          },
          "anchor": {
            "type": "string",
            "enum": ["scheduled", "completion"]
          },
          "zone": {
            "type": ["string", "null"]
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete",
      "verb": "delete",
      "kind": "task",
      "inverse": "restore",
      "sealed": [],
      "chat": "direct",
      "command": "entity.trash",
      "phrasings": [
        "delete the plumber task",
        "trash buy milk",
        "remove the old taxes task"
      ],
      "description": "Move a task and its subtasks to the 30-day trash through entity.trash; the Logbook keeps nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "purge",
      "verb": "purge",
      "kind": "task",
      "inverse": null,
      "sealed": [],
      "chat": "card",
      "command": "entity.purge",
      "phrasings": [
        "erase the plumber task forever",
        "permanently delete the trashed milk task",
        "purge the old taxes task"
      ],
      "description": "Delete a trashed task and the subtasks trashed with it forever through entity.purge (#1015 D1); a subtask restored on its own is promoted to a top-level task first.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "restore",
      "verb": "restore",
      "kind": "task",
      "inverse": "delete",
      "sealed": [],
      "chat": "direct",
      "command": "entity.restore",
      "phrasings": [
        "bring back the plumber task",
        "restore the task I deleted",
        "undelete buy milk"
      ],
      "description": "Bring a trashed task back through entity.restore, with the subtasks trashed with it; a subtask trashed on its own stays where it was.",
