          },
          "color": {
            "type": ["string", "null"]
          },
          "position": {
            "type": ["number", "null"]
          }
        },
        "required": ["kind", "title"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "create-section",
      "verb": "create",
      "kind": "section",
      "inverse": null,
      "sealed": [],
      "chat": "card",
      "command": "container.create",
      "phrasings": [
        "add a section called Kitchen to Home renovation",
        "create a Waiting section in Errands",
