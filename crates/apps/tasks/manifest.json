{
  "manifestVersion": 1,
  "id": "tasks",
  "name": "Tasks",
  "description": "A Todoist-depth task manager as a projection of the personal vault: canonical tasks from the vault's own tasks, nothing stored here. Adding, completing and editing all run through typed task commands — consent-checked, contract-checked and journalled. Revoke the grant and the app goes dark while the tasks and their history remain the owner's.",
  "version": "0.4.0",
  "iconKey": "Check",
  "colorKey": "ochre",
  "vault": {
    "why": "Shows and manages your canonical task list.",
    "scopes": [
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "task",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "container",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "edge",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "document",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "photo",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "blob",
        "verbs": "read"
      },
      {
        "schema": "task",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "edit",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "complete",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "reopen",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "cancel",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "organize",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "trash",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "purge",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "restore",
        "verbs": "act"
      },
      {
        "schema": "container",
        "table": "create",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "remove",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "remove",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "add",
      "description": "Add a task through task.add: dated, prioritized, estimated, repeating, reminded, filed in a project and section, or as a subtask of an open top-level task.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "due": {
            "type": ["string", "null"],
            "description": "A day, a wall clock or an instant."
          },
          "effort_min": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "remind_before_min": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand, and a repeating task needs a due date."
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "parent_id": {
            "type": ["string", "null"]
          },
          "project_id": {
            "type": ["string", "null"]
          },
          "section_id": {
            "type": ["string", "null"]
          },
          "anchor": {
            "type": "string",
            "enum": ["scheduled", "completion"]
          },
          "zone": {
            "type": ["string", "null"]
          },
          "position": {
            "type": "number"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "edit",
      "description": "Edit a task's title, note, due date, priority, effort, reminder lead time or repeat rule through task.edit. A key that is present is set (null clears it); a key that is absent is left alone.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "due": {
            "type": ["string", "null"],
            "description": "A day, a wall clock or an instant."
          },
          "effort_min": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "remind_before_min": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand, and a repeating task needs a due date."
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "complete",
      "description": "Complete a task through task.complete: the one completion operation Tasks, People and automations share. A repeating task gets its next occurrence, carrying its project, tags and what it is about; completing a completed task changes nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "reopen",
      "description": "Reopen a completed or cancelled task through task.reopen; it spawns nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "cancel",
      "description": "Cancel a task through task.cancel: it ends this occurrence with no successor (the Logbook's Won't do).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "organize-task",
      "description": "File a task through task.organize: its project and section (null is the Inbox), its place in the list, and what a repeat counts from. Moving to another project leaves the section behind unless one is named.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": ["string", "null"]
          },
          "section_id": {
            "type": ["string", "null"]
          },
          "position": {
            "type": "number"
          },
          "anchor": {
            "type": "string",
            "enum": ["scheduled", "completion"]
          },
          "zone": {
            "type": ["string", "null"]
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete",
      "description": "Move a task and its subtasks to the 30-day trash through entity.trash; the Logbook keeps nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "purge",
      "description": "Delete a trashed task and the subtasks trashed with it forever through entity.purge (#1015 D1); a subtask restored on its own is promoted to a top-level task first.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "restore",
      "description": "Bring a trashed task back through entity.restore, with the subtasks trashed with it; a subtask trashed on its own stays where it was.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "create-project",
      "description": "Create a project or an area through container.create. A project may sit in an area (its `parent`), and has a color and a place in the list.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["project", "area"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": ["string", "null"]
          },
          "color": {
            "type": ["string", "null"]
          },
          "position": {
            "type": ["number", "null"]
          }
        },
        "required": ["kind", "title"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "create-section",
      "description": "Create a section within a task project through container.create (the project is its `parent`).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["section"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": ["number", "null"]
          }
        },
        "required": ["kind", "title", "parent"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "attach",
      "description": "Attach a document or photo to a task through edge.add (rel attached); the bytes are the document's or photo's own.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "rel": {
            "type": "string",
            "enum": ["attached"]
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["from", "rel", "to"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "detach",
      "description": "Detach a document or photo from a task through edge.remove; the document or photo is kept.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "rel": {
            "type": "string",
            "enum": ["attached"]
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["from", "rel", "to"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "add-tag",
      "description": "Tag a task through tag.add: a free-form label shared with every other app that tags; minted on first use. Idempotent.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "label"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "remove-tag",
      "description": "Remove one tag from a task through tag.remove; the tag survives for other things.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "label"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "queries": [
    {
      "name": "board",
      "description": "The task board as a bounded window (newest open tasks by creation, caller-sized, families kept whole; the logbook read is capped at its visible 50 most recently closed), each row carrying its tags (`[{concept_id, label}]`) and what it is about, plus the distinct tag list (`[{concept_id, label}]`) seen within the window — never a whole-table pull; `truncated` is the open walk's own cursor — it exists or it does not — rather than a guess from the row count.",
      "input": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 20,
            "maximum": 500
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "open": {
            "type": "array"
          },
          "logbook": {
            "type": "array"
          },
          "tags": {
            "type": "array"
          },
          "counts": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "window": {
            "type": "integer"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "search",
      "description": "Full-text task search through the vault's one index (title, description and project) — returns only the ranked matches in the board's per-task row shape plus a hit snippet, never a whole-table pull.",
      "input": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          }
        },
        "required": ["term"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    }
  ],
  "knobs": [
    {
      "key": "appWidth",
      "label": "Width",
      "type": "segmented",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "key": "appColor",
      "label": "Color",
      "type": "swatch",
      "default": "#2EA098",
      "options": [
        {
          "value": "#4E68DD",
          "label": "Indigo"
        },
        {
          "value": "#2EA098",
          "label": "Teal"
        },
        {
          "value": "#7C5BD9",
          "label": "Violet"
        },
        {
          "value": "#E55772",
          "label": "Rose"
        },
        {
          "value": "#B47B3F",
          "label": "Ochre"
        }
      ]
    },
    {
      "key": "appDefaultView",
      "label": "Default view",
      "type": "segmented",
      "default": "today",
      "options": [
        {
          "value": "today",
          "label": "Today"
        },
        {
          "value": "upcoming",
          "label": "Upcoming"
        },
        {
          "value": "anytime",
          "label": "Anytime"
        },
        {
          "value": "all",
          "label": "All"
        }
      ]
    }
  ],
  "seats": {
    "byteBearing": false,
    "originActs": [],
    "disabledOn": [],
    "northStar": "todoist"
  },
  "states": {
    "designed": [
      "dayone",
      "pending",
      "offline",
      "stale",
      "conflict",
      "parked",
      "denied"
    ],
    "excluded": []
  }
}
