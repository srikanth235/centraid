  "queries": [
    {
      "name": "board",
      "kind": "task",
      "figures": ["open", "logbook", "tags", "counts"],
      "description": "The task board as a bounded window (newest open tasks by creation, caller-sized, families kept whole; the logbook read is capped at its visible 50 most recently closed), each row carrying its tags (`[{concept_id, label}]`) and what it is about, plus the distinct tag list (`[{concept_id, label}]`) seen within the window — never a whole-table pull; `truncated` is the open walk's own cursor — it exists or it does not — rather than a guess from the row count.",
      "input": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 20,
            "maximum": 500
          },
          "view": {
            "type": "string",
            "enum": ["today", "upcoming", "inbox", "anytime", "all", "logbook", "reminders", "project"],
            "description": "How the rows are grouped; the rows are the same board read whichever is asked."
          },
          "project_id": {
            "type": "string",
            "description": "With view `project`: the project."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "open": {
            "type": "array"
          },
          "logbook": {
            "type": "array"
          },
          "tags": {
            "type": "array"
          },
          "counts": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "window": {
            "type": "integer"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "search",
      "kind": "task",
      "figures": ["matches"],
      "description": "Full-text task search through the vault's one index (title, description and project) — returns only the ranked matches in the board's per-task row shape plus a hit snippet, never a whole-table pull.",
      "input": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          }
        },
        "required": ["term"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "task",
      "kind": "task",
      "figures": ["task"],
