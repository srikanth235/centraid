          },
          "reason": {
            "type": "string"
          }
        }
      },
      "writes": ["knowledge.annotation"]
    },
    {
      "name": "export",
      "description": "Receipt the mass reveal an export is, through locker.export, before the phone core opens every live and archived secret and renders the file (1Password CSV or Locker JSON). It is confirmed, the phone asks its owner check afresh, and the file goes only to the system's save sheet. Anything that reads the file reads your secrets. A passkey's key and previous passwords are never in it.",
      "confirmation": "required",
      "input": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean"
          },
          "include_trashed": {
            "type": "boolean"
          },
          "include_history": {
            "type": "boolean"
          }
        },
        "required": ["confirm"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
