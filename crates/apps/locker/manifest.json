      "name": "add-item",
      "description": "Save a new item through locker.add_item — any of the fifteen item types. Secret fields not belonging to the chosen type are dropped, never stored; a type that owns no columns of its own arrives as the template fields the vault mints for it.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "login",
              "card",
              "note",
              "identity",
              "wifi",
              "password",
              "ssh_key",
              "api_credential",
              "passport",
              "bank_account",
              "driving_licence",
              "software_licence",
              "crypto_wallet",
              "membership",
              "document"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compromised": {
            "type": "boolean",
            "description": "The member's compromised flag: Review lists the item for changing. Nothing produces it automatically; a changed password clears it unless the same write sets it (R-1047-F7)."
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "otp_seed": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "cardholder": {
            "type": "string"
          },
          "card_number": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          },
          "cvv": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "fullname": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "alias": {
