          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "propose",
      "verb": "create",
      "kind": "event",
      "inverse": "cancel-event",
      "sealed": [],
      "command": "event.propose",
      "phrasings": [
        "put lunch with Sam on Friday at noon",
        "add a dentist appointment next Tuesday at 3pm",
        "schedule a team sync every Monday morning"
      ],
      "description": "Propose an event through event.propose: its title, when (an instant, or a wall clock in a zone), an optional repeat rule, guests, place, link and reminders. Refused when a busy event would land on another busy one; a free event blocks nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "aliases": ["name"]
          },
          "description": {
            "type": ["string", "null"],
            "aliases": ["description"]
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand."
          },
          "calendar_id": {
            "type": "string",
            "minLength": 1
          },
          "place_id": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"],
            "description": "The joining link."
          },
          "reminders": {
            "type": ["array", "null"],
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Minutes before it starts."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The people invited, by person id."
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "tentative", "cancelled"]
          },
          "busy": {
            "type": "boolean"
          },
          "starts": {
            "type": "string",
            "minLength": 1,
            "description": "An instant (...Z), a wall clock in `zone`, a floating wall clock, or a date for an all-day event.",
            "aliases": ["date", "start"]
          },
          "ends": {
            "type": ["string", "null"],
            "description": "Exclusive for a timed event; the LAST day, inclusive, for an all-day one.",
            "aliases": ["duration"]
          },
          "timing": {
            "type": "string",
            "enum": ["zoned", "floating", "all-day"]
          },
          "zone": {
            "type": ["string", "null"],
            "description": "An IANA zone; with it a wall clock is that zone's."
          },
          "travel_min": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Minutes of travel to allow before it starts; null clears it."
          }
        },
        "required": ["title", "starts"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
