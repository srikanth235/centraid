{
  "manifestVersion": 1,
  "id": "calendar",
  "name": "Calendar",
  "description": "Your events and invites as a projection of the personal vault: upcoming events from the vault's events, expanded from their rules in the zone the device states, with the reminders that fall on each day, every occurrence of a repeating one and the overdue ones on today. Reminders is its own app: a reminder opens there, and ticking one on a day is Reminders' own action, so Calendar holds no task write.",
  "version": "1.0.0",
  "iconKey": "Calendar",
  "colorKey": "forest",
  "vault": {
    "why": "Shows your upcoming schedule and lets you propose, move, and respond to events. It reads the title, due date and state of your reminders to show them on their day, and never changes one itself: a tick on a day is sent to Reminders.",
