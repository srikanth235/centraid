{
  "manifestVersion": 1,
  "id": "photos",
  "name": "Photos",
  "description": "Your photo library as a projection of the vault: a photograph is an entity over one blob — its title is the caption, its capture time, size and place are columns of its row — an album is a container with an ordered list of photographs, a heart or the archive is an edge to a flag, and a thumbnail, a caption or a perceptual hash is a derivative of the bytes. Uploading, captioning, deleting and organizing into albums all run through typed vault commands — the photograph's own (photo.*, album.set_cover) and the shared ones every app uses — contract-checked and journalled, and identical bytes are one photograph. No data of its own — revoke the grant and the app goes dark while the library stays the owner's.",
  "version": "0.5.0",
  "iconKey": "Camera",
  "colorKey": "amber",
  "vault": {
    "why": "Shows your photo library and albums, and lets you upload, caption and organize.",
    "scopes": [
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "photo",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "place",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "container",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "edge",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "blob",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "derivative",
        "verbs": "read"
      },
      {
        "schema": "photo",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "photo",
        "table": "edit",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "retitle",
        "verbs": "act"
      },
      {
        "schema": "flag",
        "table": "set",
        "verbs": "act"
      },
      {
        "schema": "flag",
        "table": "clear",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "trash",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "restore",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "purge",
        "verbs": "act"
      },
      {
        "schema": "container",
        "table": "create",
        "verbs": "act"
      },
      {
        "schema": "album",
        "table": "set_cover",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "remove",
        "verbs": "act"
      },
      {
        "schema": "photo",
        "table": "set_place",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "remove",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "upload",
      "verb": "import",
      "kind": "photo",
      "inverse": "delete-photo",
      "sealed": [],
      "chat": "card",
      "command": "photo.add",
      "phrasings": [
        "add this photo to my library",
        "upload these pictures",
        "save this image"
      ],
      "description": "Add one file to the library through photo.add; identical bytes are one photograph (the existing one is adopted), and re-uploading a deleted photograph brings it back. An edit names the photograph it was made from and keeps that one's date, place and caption.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "blob": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "string",
            "enum": ["photo", "video", "scan"]
          },
          "title": {
            "type": "string"
          },
          "taken_at": {
            "type": ["string", "null"]
          },
          "offset_min": {
            "type": ["integer", "null"],
            "minimum": -1080,
            "maximum": 1080
          },
          "width": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "height": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "duration_s": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "exif": {
            "type": ["object", "null"]
          },
          "burst": {
            "type": ["string", "null"]
          },
          "edited_from": {
            "type": ["string", "null"]
          },
          "lat": {
            "type": ["number", "null"],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": ["number", "null"],
            "minimum": -180,
            "maximum": 180
          },
          "place_id": {
            "type": ["string", "null"]
          },
          "phash": {
            "type": ["string", "null"],
            "maxLength": 128
          },
          "thumbhash": {
            "type": ["string", "null"],
            "maxLength": 512
          }
        },
        "required": ["blob", "media_type"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
