{
  "manifestVersion": 1,
  "id": "health",
  "name": "Health",
  "description": "Your body's daily record, followed from the phone's health store one way \u2014 Apple Health on iOS, Health Connect on Android \u2014 into the vault, so it is in your backup and nowhere else. Daily totals (steps, active energy, exercise minutes, sleep, resting heart rate and weight) and workouts, never raw samples. Today shows each number against your own 30-day typical, not a target; Trends shows weeks, months and a year; Workouts lists every workout the store holds. Every typical, average and trend is derived at read time and nothing derived is stored. Nothing is ever written back to the health store, and Chat does not read Health.",
  "version": "0.1.0",
  "iconKey": "Activity",
  "colorKey": "olive",
  "vault": {
    "why": "Reads the daily totals and workouts the phone's health store holds, which it follows into the vault one way, and nothing else.",
    "scopes": [
      {
        "schema": "core",
        "table": "party",
        "verbs": "read"
      },
      {
        "schema": "core",
        "table": "activity",
        "verbs": "read"
      },
      {
        "schema": "core",
        "table": "concept",
        "verbs": "read"
      },
      {
        "schema": "health",
        "table": "daily",
        "verbs": "read+act"
      },
      {
        "schema": "health",
        "table": "workout",
        "verbs": "read+act"
      },
      {
        "schema": "phone",
        "table": "origin",
        "verbs": "read"
      },
      {
        "schema": "phone",
        "table": "link",
        "verbs": "read"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "record-days",
      "description": "Record a batch of the store's daily totals through health.record_days: a value the vault already holds is not touched, a changed one is replaced, a new one added. A day is never deleted.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "required": ["days"],
        "additionalProperties": false,
        "properties": {
          "subject_party_id": {
            "type": "string",
            "minLength": 1
          },
          "days": {
            "type": "array",
            "maxItems": 4000,
            "items": {
              "type": "object",
              "required": ["day", "metric", "value"],
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "metric": {
                  "enum": [
                    "steps",
                    "active_energy_kcal",
                    "exercise_min",
                    "sleep_min",
                    "resting_hr_bpm",
                    "weight_kg"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "follow-workout",
      "description": "Follow one workout from the store through health.follow_workout: its activity (kind and span) and what the store measured, written or corrected in place under the id the follower minted.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "required": [
          "activity_id",
          "kind",
          "phone_kind",
          "started_at",
          "ended_at"
        ],
        "additionalProperties": false,
        "properties": {
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "phone_kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "started_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
          },
          "ended_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
          },
          "recorded_by": {
            "type": ["string", "null"],
            "maxLength": 200
          },
          "moving_sec": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "distance_m": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "energy_kcal": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "avg_hr_bpm": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "elevation_gain_m": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "purge-workout",
      "description": "Delete a workout forever through health.purge_workout: an activity has no trash, and the phone link it followed stays as the tombstone that keeps it from arriving again.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "required": ["activity_id"],
        "additionalProperties": false,
        "properties": {
          "activity_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "queries": [
    {
      "name": "today",
      "description": "Today: each metric's figure against your own typical (the median of the 30 whole days before today) and its usual range, today's workouts, whether a store is connected and which metrics have any data.",
      "input": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "day_start": {
            "type": "string"
          },
          "day_end": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": ["today", "day_start", "day_end"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "series",
      "description": "One metric over a week, a month or a year: its buckets, the period's per-day average against the one before, the typical, the best day or month, the total for a count, and how many days were above typical.",
      "input": {
        "type": "object",
        "properties": {
          "metric": {
            "enum": [
              "steps",
              "sleep_min",
              "active_energy_kcal",
              "exercise_min",
              "resting_hr_bpm",
              "weight_kg"
            ]
          },
          "range": {
            "enum": ["week", "month", "year"]
          },
          "today": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false,
        "required": ["metric", "range", "today"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "trends",
      "description": "Every metric over 30 days, 90 days or a year: the period's per-day average against the one before, and a sparkline's buckets. A metric with no data in either period is left out.",
      "input": {
        "type": "object",
        "properties": {
          "range": {
            "enum": ["days_30", "days_90", "year"]
          },
          "today": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false,
        "required": ["range", "today"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "workouts",
      "description": "A page of every workout, newest first, or one kind's, with each kind's count for the filter.",
      "input": {
        "type": "object",
        "properties": {
          "kind_concept_id": {
            "type": "string"
          },
          "cursor": {
            "type": "object"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false,
        "required": ["limit"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "workout",
      "description": "One workout: its kind, span and everything the store measured.",
      "input": {
        "type": "object",
        "properties": {
          "activity_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": ["activity_id"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "follow-view",
      "description": "What the follower reads before a pass: the newest day and the newest workout the vault holds, and every daily total since a day, so it sends only what moved.",
      "input": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false,
        "required": ["since"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "states": {
    "designed": [
      "dayone",
      "pending",
      "offline",
      "stale",
      "conflict",
      "parked",
      "denied"
    ],
    "excluded": []
  }
}
