  "queries": [
    {
      "name": "today",
      "kind": "daily_figure",
      "figures": [
        "figure",
        "typical",
        "usual_range",
        "workouts_today",
        "connected_store"
      ],
      "description": "Today: each metric's figure against your own typical (the median of the 30 whole days before today) and its usual range, today's workouts, whether a store is connected and which metrics have any data.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "series",
      "kind": "daily_figure",
      "figures": [
        "buckets",
        "average",
        "previous_average",
        "typical",
        "best",
        "total",
        "days_above_typical"
      ],
      "description": "One metric over a week, a month, six months (26 weekly buckets) or a year: its buckets, the period's per-day average against the one before, the typical, the best day or month, the total for a count, and how many days were above typical.",
      "input": {
        "type": "object",
        "properties": {
          "metric": {
            "enum": [
              "steps",
              "sleep_min",
              "active_energy_kcal",
              "exercise_min",
              "resting_hr_bpm",
              "weight_kg"
            ]
          },
          "range": {
            "enum": ["week", "month", "six_months", "year"]
          }
        },
        "additionalProperties": false,
        "required": ["metric", "range"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "trends",
      "kind": "daily_figure",
      "figures": ["average", "previous_average", "buckets"],
      "description": "Every metric over 30 days, 90 days or a year: the period's per-day average against the one before, and a sparkline's buckets. A metric with no data in either period is left out.",
      "input": {
        "type": "object",
        "properties": {
          "range": {
            "enum": ["days_30", "days_90", "year"]
          }
        },
        "additionalProperties": false,
        "required": ["range"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "workouts",
      "kind": "workout",
      "figures": ["workouts", "count_by_kind"],
      "description": "A page of every workout, newest first, or one kind's, with each kind's count for the filter.",
      "input": {
        "type": "object",
        "properties": {
          "kind_concept_id": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "after": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": ["limit"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
