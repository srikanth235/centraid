{
  "manifestVersion": 1,
  "id": "health",
  "name": "Health",
  "description": "Your body's daily record, followed from the phone's health store one way — Apple Health on iOS, Health Connect on Android — into the vault, so it is in your backup and nowhere else. Daily totals (steps, active energy, exercise minutes, sleep, resting heart rate and weight) and workouts, never raw samples. Today shows each number against your own 30-day typical, not a target; Trends shows weeks, months and a year; Workouts lists every workout the store holds. Every typical, average and trend is derived at read time and nothing derived is stored. Nothing is ever written back to the health store, and Chat does not read Health.",
  "version": "0.2.0",
  "iconKey": "Activity",
  "colorKey": "olive",
  "vault": {
    "why": "Reads the daily totals and workouts the phone's health store holds, which it follows into the vault one way, and nothing else.",
    "scopes": [
      {
        "schema": "vault",
        "table": "vault",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "concept",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "activity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "workout",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "measurement",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "origin",
        "verbs": "read"
      },
      {
        "schema": "measurement",
        "table": "record",
        "verbs": "act"
      },
      {
        "schema": "follow",
        "table": "health",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "trash",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "record-days",
      "description": "Record a batch of the store's daily totals through measurement.record: a value the vault already holds is not written, a changed one is replaced, a new one added. A day is never deleted.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "day": {
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "type": "string"
                },
                "metric": {
                  "enum": [
                    "steps",
                    "active_energy_kcal",
                    "exercise_min",
                    "sleep_min",
                    "resting_hr_bpm",
                    "weight_kg"
                  ]
                },
                "value": {
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": ["day", "metric", "value"],
              "type": "object"
            },
            "maxItems": 4000,
            "type": "array"
          },
          "person_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["days"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "follow-workouts",
      "description": "Follow the store's workouts through follow.health: each is an activity of a workout kind and what the store measured, written or corrected in place under the store's own id; one gone from a complete read keeps its row and forgets its source.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "origin": {
            "additionalProperties": false,
            "properties": {
              "config": {
                "type": ["object", "null"]
              },
              "device_id": {
                "type": ["string", "null"]
              },
              "fills": {
                "type": ["string", "null"]
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": ["ref", "label"],
            "type": "object"
          },
          "records": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "device_id": {
                  "type": ["string", "null"]
                },
                "external_id": {
                  "type": "string"
                },
                "fields": {
                  "type": "object"
                }
              },
              "required": ["external_id", "fields"],
              "type": "object"
            },
            "type": "array"
          },
          "since": {
            "type": "string"
          }
        },
        "required": ["origin", "records"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete-workout",
      "description": "Move a workout to the trash through entity.trash, like any entity: the vault keeps it thirty days.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "queries": [
    {
      "name": "today",
      "description": "Today: each metric's figure against your own typical (the median of the 30 whole days before today) and its usual range, today's workouts, whether a store is connected and which metrics have any data.",
      "input": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "day_start": {
            "type": "string"
          },
          "day_end": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": ["today", "day_start", "day_end"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "series",
      "description": "One metric over a week, a month or a year: its buckets, the period's per-day average against the one before, the typical, the best day or month, the total for a count, and how many days were above typical.",
      "input": {
        "type": "object",
        "properties": {
          "metric": {
            "enum": [
              "steps",
              "sleep_min",
              "active_energy_kcal",
              "exercise_min",
              "resting_hr_bpm",
              "weight_kg"
            ]
          },
          "range": {
            "enum": ["week", "month", "year"]
          },
          "today": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false,
        "required": ["metric", "range", "today"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "trends",
      "description": "Every metric over 30 days, 90 days or a year: the period's per-day average against the one before, and a sparkline's buckets. A metric with no data in either period is left out.",
      "input": {
        "type": "object",
        "properties": {
          "range": {
            "enum": ["days_30", "days_90", "year"]
          },
          "today": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false,
        "required": ["range", "today"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "workouts",
      "description": "A page of every workout, newest first, or one kind's, with each kind's count for the filter.",
      "input": {
        "type": "object",
        "properties": {
          "kind_concept_id": {
            "type": "string"
          },
          "cursor": {
            "type": "object"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false,
        "required": ["limit"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "workout",
      "description": "One workout: its kind, span and everything the store measured.",
      "input": {
        "type": "object",
        "properties": {
          "activity_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": ["activity_id"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "follow-view",
      "description": "What the follower reads before a pass: the newest day and the newest workout the vault holds, and every daily total since a day, so it sends only what moved.",
      "input": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false,
        "required": ["since"]
      },
      "output": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "states": {
    "designed": [
      "dayone",
      "pending",
      "offline",
      "stale",
      "conflict",
      "parked",
      "denied"
    ],
    "excluded": []
  }
}
