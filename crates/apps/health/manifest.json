          "ends": {
            "type": "string",
            "minLength": 1,
            "aliases": ["end"]
          },
          "moving_s": {
            "type": "integer",
            "minimum": 1,
            "aliases": ["moving"]
          },
          "distance_m": {
            "type": "number",
            "minimum": 0,
            "aliases": ["distance"]
          },
          "energy_kcal": {
            "type": "number",
            "minimum": 0,
            "aliases": ["energy"]
          },
          "heart_bpm": {
            "type": "integer",
            "minimum": 1,
            "aliases": ["heart_rate"]
          },
          "climb_m": {
            "type": "number",
            "minimum": 0,
            "aliases": ["climb"]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "x-minted": true
          }
        },
        "required": ["starts"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
