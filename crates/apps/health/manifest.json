      "verb": "purge",
      "kind": "workout",
      "inverse": null,
      "sealed": [],
      "bulk": true,
      "command": "entity.empty_trash",
      "phrasings": [
        "empty the workout trash",
        "clear out the trashed workouts for good",
        "permanently delete everything in the Health trash"
      ],
      "description": "Empty the workout trash through entity.empty_trash with kind activity and having workout (a touch trashed with its person is not a workout and stays). Irreversible and takes no id: every workout in the trash is destroyed now, as purge destroys one.",
