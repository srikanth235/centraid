{
  "manifestVersion": 1,
  "id": "health",
  "name": "Health",
  "description": "Your body's daily record, followed from the phone's health store one way — Apple Health on iOS, Health Connect on Android — into the vault, so it is in your backup and nowhere else. Daily totals (steps, active energy, exercise minutes, sleep, resting heart rate and weight) and workouts, never raw samples. Today shows each number against your own 30-day typical, not a target; Trends shows weeks, months and a year; Workouts lists every workout the store holds. Every typical, average and trend is derived at read time and nothing derived is stored. Nothing is ever written back to the health store. Chat reads it like any app: the daily figures and workouts are kinds the assistant finds, counts and sums.",
  "version": "0.2.0",
  "iconKey": "Activity",
  "colorKey": "olive",
  "vault": {
    "why": "Reads the daily totals and workouts the phone's health store holds, which it follows into the vault one way, and the workouts and figures the member logs by hand; nothing is written back to the store.",
    "scopes": [
      {
        "schema": "vault",
        "table": "vault",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "concept",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "activity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "workout",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "measurement",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "origin",
        "verbs": "read"
      },
      {
        "schema": "measurement",
        "table": "record",
        "verbs": "act"
      },
      {
        "schema": "follow",
        "table": "health",
        "verbs": "act"
      },
      {
        "schema": "follow",
        "table": "stop",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "trash",
        "verbs": "act"
      },
      {
        "schema": "workout",
        "table": "log",
        "verbs": "act"
      },
      {
        "schema": "workout",
        "table": "edit",
        "verbs": "act"
      },
      {
        "schema": "measurement",
        "table": "log",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "restore",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "purge",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "empty_trash",
        "verbs": "act"
      },
      {
        "schema": "measurement",
        "table": "clear",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "record-days",
      "verb": "log",
      "kind": "daily_figure",
      "inverse": null,
      "sealed": [],
      "bulk": true,
      "command": "measurement.record",
      "phrasings": [
        "log 8000 steps for today",
        "record last night's sleep as seven hours",
        "note my weight as 70 kilos this morning"
      ],
      "description": "Record a batch of the store's daily totals through measurement.record: a value the vault already holds is not written, a changed one is replaced, a new one added. A day is never deleted.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "day": {
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "type": "string"
                },
                "metric": {
                  "enum": [
                    "steps",
                    "active_energy_kcal",
                    "exercise_min",
                    "sleep_min",
                    "resting_hr_bpm",
                    "weight_kg"
                  ]
                },
                "value": {
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": ["day", "metric", "value"],
              "type": "object"
            },
            "maxItems": 4000,
            "type": "array"
          },
          "person_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["days"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "follow-workouts",
      "verb": "import",
      "kind": "workout",
      "inverse": null,
      "sealed": [],
      "bulk": true,
      "command": "follow.health",
      "phrasings": [
        "pull in my latest workouts",
        "sync workouts from the health store",
        "import this week's runs"
      ],
      "description": "Follow the store's workouts through follow.health: each is an activity of a workout kind and what the store measured, written or corrected in place under the store's own id; one gone from a complete read keeps its row and forgets its source.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "origin": {
            "additionalProperties": false,
            "properties": {
              "color": {
                "description": "The colour the phone paints the store with, as the design wheel names it.",
                "maxLength": 64,
                "type": ["string", "null"]
              },
              "config": {
                "type": ["object", "null"]
              },
              "device_id": {
                "type": ["string", "null"]
              },
              "fills": {
                "type": ["string", "null"]
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": ["ref", "label"],
            "type": "object"
          },
          "records": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "device_id": {
                  "type": ["string", "null"]
                },
                "external_id": {
                  "type": "string"
                },
                "fields": {
                  "type": "object"
                },
                "size": {
                  "description": "How large the bytes a record names are, counted by the phone; the command claims them.",
                  "minimum": 0,
                  "type": ["integer", "null"]
                }
              },
              "required": ["external_id", "fields"],
              "type": "object"
            },
            "type": "array"
          },
          "since": {
            "type": "string"
          }
        },
        "required": ["origin", "records"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete-workout",
      "verb": "delete",
      "kind": "workout",
      "inverse": "restore-workout",
      "sealed": [],
      "command": "entity.trash",
      "phrasings": [
        "delete this morning's run",
        "remove the duplicate workout",
        "trash yesterday's swim"
      ],
      "description": "Move a workout to the trash through entity.trash, like any entity: the vault keeps it thirty days.",
      "confirmation": "none",
      "input": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "stop-following",
      "verb": "detach",
      "kind": "daily_figure",
      "inverse": null,
      "sealed": [],
      "command": "follow.stop",
      "phrasings": [
        "stop reading my health app",
        "disconnect Apple Health",
        "stop following Health Connect"
      ],
      "description": "Stop following the phone's health store through follow.stop: the store's origin is retired and its workouts forget their source. Every day and every workout stays, an ordinary row from now on.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "required": ["system", "ref"],
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "enum": ["contacts", "calendar", "files", "health", "statement"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "log-workout",
      "verb": "create",
      "kind": "workout",
      "inverse": "delete-workout",
      "sealed": [],
      "command": "workout.log",
      "phrasings": [
        "log a 5k run this morning",
        "add a 30 minute swim for yesterday",
        "I did yoga at 7"
      ],
      "description": "Log a workout by hand through workout.log: an activity of a workout kind and what was measured, with no store behind it. A workout the health store follows is the store's to state.",
