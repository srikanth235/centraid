{
  "manifestVersion": 1,
  "id": "agenda",
  "name": "Agenda",
  "description": "Your calendar as a projection of the personal vault: upcoming events from the vault's events, proposals, answers and cancellation asks through consent-checked typed commands (cancelling is medium-risk, so it parks for the owner's confirmation). No data of its own — revoke the grant and the app goes dark.",
  "version": "0.6.0",
  "iconKey": "Calendar",
  "colorKey": "forest",
  "vault": {
    "why": "Shows your upcoming schedule and lets you propose, move, and respond to events.",
    "scopes": [
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "event",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "occurrence",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "edge",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "person",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "container",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "document",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "photo",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "blob",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "vault",
        "verbs": "read"
      },
      {
        "schema": "event",
        "table": "propose",
        "verbs": "act"
      },
      {
        "schema": "event",
        "table": "respond",
        "verbs": "act"
      },
      {
        "schema": "event",
        "table": "edit",
        "verbs": "act"
      },
      {
        "schema": "event",
        "table": "edit_occurrence",
        "verbs": "act"
      },
      {
        "schema": "event",
        "table": "cancel",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "remove",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "propose",
      "verb": "create",
      "kind": "event",
      "inverse": "cancel-event",
      "sealed": [],
      "chat": "direct",
      "command": "event.propose",
      "phrasings": [
        "put lunch with Sam on Friday at noon",
        "add a dentist appointment next Tuesday at 3pm",
        "schedule a team sync every Monday morning"
      ],
      "description": "Propose an event through event.propose: its title, when (an instant, or a wall clock in a zone), an optional repeat rule, guests, place, link and reminders. Refused when a busy event would land on another busy one; a free event blocks nothing.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand."
          },
          "calendar_id": {
            "type": "string",
            "minLength": 1
          },
          "place_id": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"],
            "description": "The joining link."
          },
          "reminders": {
            "type": ["array", "null"],
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Minutes before it starts."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The people invited, by person id."
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "tentative", "cancelled"]
          },
          "busy": {
            "type": "boolean"
          },
          "starts": {
            "type": "string",
            "minLength": 1,
            "description": "An instant (...Z), a wall clock in `zone`, a floating wall clock, or a date for an all-day event."
          },
          "ends": {
            "type": ["string", "null"],
            "description": "Exclusive for a timed event; the LAST day, inclusive, for an all-day one."
          },
          "timing": {
            "type": "string",
            "enum": ["zoned", "floating", "all-day"]
          },
          "zone": {
            "type": ["string", "null"],
            "description": "An IANA zone; with it a wall clock is that zone's."
          }
        },
        "required": ["title", "starts"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "rsvp",
      "verb": "respond",
      "kind": "event",
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "event.respond",
      "phrasings": [
        "accept the Friday dinner invite",
        "decline Sam's party",
        "mark me tentative for the offsite"
      ],
      "description": "Record one guest's answer to an event through event.respond: accepted, declined or tentative.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "person_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": ["accepted", "declined", "tentative"]
          }
        },
        "required": ["id", "person_id", "state"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "edit-event",
      "verb": "edit",
      "kind": "event",
      "also": ["reschedule"],
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "event.edit",
      "phrasings": [
        "rename the dentist event to checkup",
        "move the team sync to 4pm",
        "add a note to Friday's dinner that it's at Luigi's"
      ],
      "description": "Revise an event through event.edit. A key that is present is set (null clears it); a key that is absent is left alone. A change to the series that would leave a skipped or moved day matching nothing is refused.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "rule": {
            "type": ["string", "null"],
            "description": "An RFC 5545 recurrence rule; the vault refuses one it cannot expand."
          },
          "calendar_id": {
            "type": "string",
            "minLength": 1
          },
          "place_id": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"],
            "description": "The joining link."
          },
          "reminders": {
            "type": ["array", "null"],
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Minutes before it starts."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The people invited, by person id."
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "tentative", "cancelled"]
          },
          "busy": {
            "type": "boolean"
          },
          "starts": {
            "type": "string",
            "minLength": 1,
            "description": "An instant (...Z), a wall clock in `zone`, a floating wall clock, or a date for an all-day event."
          },
          "ends": {
            "type": ["string", "null"],
            "description": "Exclusive for a timed event; the LAST day, inclusive, for an all-day one."
          },
          "timing": {
            "type": "string",
            "enum": ["zoned", "floating", "all-day"]
          },
          "zone": {
            "type": ["string", "null"],
            "description": "An IANA zone; with it a wall clock is that zone's."
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "edit-occurrence",
      "verb": "reschedule",
      "kind": "event",
      "inverse": null,
      "sealed": [],
      "chat": "card",
      "command": "event.edit_occurrence",
      "phrasings": [
        "skip this week's standup",
        "move Thursday's yoga to Friday",
        "rename tomorrow's call to planning"
      ],
      "description": "Skip, move, rename or put back one day of a repeating event through event.edit_occurrence, keyed by the series-local wall clock the rule produced (`original_start`). Scope `occurrence` is that day, `future` is that day and every one after it, `series` is the whole event.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "original_start": {
            "type": "string",
            "minLength": 1,
            "description": "The series-local wall clock the rule produced for the day."
          },
          "scope": {
            "type": "string",
            "enum": ["occurrence", "future", "series"]
          },
          "action": {
            "type": "string",
            "enum": ["skip", "override", "restore"]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "starts": {
            "type": "string",
            "minLength": 1,
            "description": "An instant (...Z), a wall clock in `zone`, a floating wall clock, or a date for an all-day event."
          },
          "ends": {
            "type": ["string", "null"],
            "description": "Exclusive for a timed event; the LAST day, inclusive, for an all-day one."
          },
          "timing": {
            "type": "string",
            "enum": ["zoned", "floating", "all-day"]
          },
          "zone": {
            "type": ["string", "null"],
            "description": "An IANA zone; with it a wall clock is that zone's."
          }
        },
        "required": ["id", "original_start", "scope", "action"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "cancel-event",
      "verb": "cancel",
      "kind": "event",
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "event.cancel",
      "phrasings": [
        "cancel the dentist appointment",
        "call off Friday's dinner",
        "cancel my 3pm meeting"
      ],
      "description": "Cancel an event through event.cancel: a status its guests see, not a deletion (the trash is entity.trash).",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "attach",
      "verb": "attach",
      "kind": "event",
      "inverse": "detach",
      "sealed": [],
      "chat": "card",
      "command": "edge.add",
      "phrasings": [
        "attach the menu to Friday's dinner",
        "add the boarding pass to my flight event",
        "attach the agenda doc to the team sync"
      ],
      "description": "Attach a document or photo to an event through edge.add (rel attached); the bytes are the document's or photo's own.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "rel": {
            "type": "string",
            "enum": ["attached"]
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["from", "rel", "to"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "detach",
      "verb": "detach",
      "kind": "event",
      "inverse": "attach",
      "sealed": [],
      "chat": "card",
      "command": "edge.remove",
      "phrasings": [
        "detach the menu from Friday's dinner",
        "remove the boarding pass from my flight event",
        "take the agenda doc off the team sync"
      ],
      "description": "Detach a document or photo from an event through edge.remove; the document or photo is kept.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "rel": {
            "type": "string",
            "enum": ["attached"]
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["from", "rel", "to"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "queries": [
    {
      "name": "upcoming",
      "kind": "event",
      "figures": ["events", "calendars", "occurrences", "guests", "reminders"],
      "description": "Non-cancelled events, soonest first, with the calendars they could land on, each event's calendar_id, link, reminders, its attachments and its guest list (each `{party_id, name, partstat, is_you}`, read from the event's attendee edges). Defaults to today forward; pass ISO `from`/`to` instants to read any visible range (month and week views do), including still-running multi-day events that began before `from`. A repeating event (rule set) is materialized into one row per occurrence inside the visible range, each carrying the series' real event_id, an `instance_key` for list render and the `original_start_local` an occurrence edit is keyed on; a skipped day is left out and a moved one is where it moved to. Every occurrence also carries where it falls in the request's `tz`.",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array"
          },
          "calendars": {
            "type": "array"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "search",
      "kind": "event",
      "figures": ["matches"],
      "description": "Full-text event search through the vault's one index (title, description and place) — returns only the ranked non-cancelled matches in the upcoming row shape plus a hit snippet, never a whole-table pull.",
      "input": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          }
        },
        "required": ["term"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "day-context",
      "kind": "event",
      "figures": ["birthdays", "holidays"],
      "description": "The cross-app facts that decorate a calendar day, as one read-only projection: birthdays recurring inside the window (each `{party_id, name, month, day, tier}`, where `tier` is `inner` when the owner starred that person and `outer` otherwise), and holidays. Holidays are always `[]` today — the vault has no holiday source. It reads no task: a dated task is a row in its day, read from `tasks.board`. `from`/`to` are inclusive `YYYY-MM-DD` days, defaulting to today plus 45 days and capped at a 400-day span.",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "birthdays": {
            "type": "array"
          },
          "holidays": {
            "type": "array"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "parties",
      "kind": "person",
      "figures": ["parties"],
      "description": "Pickable people for the invite picker — each `{party_id, name, is_you}`, you sorted first. `me` is the owner's person id. No event data; just the directory the create-event attendee multi-select draws from.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "parties": {
            "type": "array"
          },
          "me": {
            "type": "string"
          },
          "vaultDenied": {
            "type": "object"
          }
        }
      }
    }
  ],
  "kinds": [
    {
      "id": "event",
      "name": "event",
      "plural": "events",
      "order": 1,
      "live": "write",
      "entity": "event",
      "table": "event",
      "pk": "id",
      "nameSource": ["entity", "title"],
      "date": {
        "label": "start",
        "source": ["event", "starts"]
      },
      "fields": [
        {
          "name": "status",
          "type": "enum",
          "source": ["event", "status"],
          "values": [
            ["confirmed", "confirmed"],
            ["tentative", "tentative"],
            ["cancelled", "cancelled"]
          ]
        },
        {
          "name": "duration",
          "type": "number",
          "source": ["event", "ends"],
          "unit": "min",
          "edit": "event.edit",
          "create": true
        },
        {
          "name": "description",
          "type": "text",
          "source": ["event", "description"],
          "edit": "event.edit",
          "create": true
        }
      ],
      "links": [{"kind": "person", "label": "people", "via": "attendee"}],
      "trash": true,
      "container": false
    }
  ],
  "knobs": [
    {
      "key": "appWidth",
      "label": "Width",
      "type": "segmented",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "key": "appColor",
      "label": "Color",
      "type": "swatch",
      "default": "#4E68DD",
      "options": [
        {
          "value": "#4E68DD",
          "label": "Indigo"
        },
        {
          "value": "#2EA098",
          "label": "Teal"
        },
        {
          "value": "#7C5BD9",
          "label": "Violet"
        },
        {
          "value": "#E55772",
          "label": "Rose"
        },
        {
          "value": "#B47B3F",
          "label": "Ochre"
        }
      ]
    },
    {
      "key": "appDefaultView",
      "label": "Default view",
      "type": "segmented",
      "default": "month",
      "options": [
        {
          "value": "month",
          "label": "Month"
        },
        {
          "value": "week",
          "label": "Week"
        },
        {
          "value": "schedule",
          "label": "Schedule"
        }
      ]
    }
  ],
  "seats": {
    "byteBearing": false,
    "originActs": [],
    "disabledOn": [],
    "northStar": "google-calendar"
  },
  "states": {
    "designed": [
      "dayone",
      "pending",
      "offline",
      "stale",
      "conflict",
      "parked",
      "denied"
    ],
    "excluded": []
  }
}
