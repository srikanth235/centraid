{
  "manifestVersion": 1,
  "id": "notes",
  "name": "Notes",
  "description": "Your notebooks as a projection of the vault: a note is an entity with its words on the note row, a notebook is a container, a pin or a tag is an edge, a past version is a revision. Creating, editing, filing, pinning and deleting all run through typed commands — the note's own (note.*) and the shared ones every app uses (entity.*, flag.*, tag.*, edge.*, container.*) — contract-checked and journalled, with act consent granted per command.",
  "version": "0.9.0",
  "iconKey": "Book",
  "colorKey": "slate",
  "vault": {
    "why": "Shows and manages your notes and notebooks.",
    "scopes": [
      {
        "schema": "vault",
        "table": "entity",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "note",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "container",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "edge",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "revision",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "concept",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "person",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "event",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "task",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "document",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "photo",
        "verbs": "read"
      },
      {
        "schema": "vault",
        "table": "blob",
        "verbs": "read"
      },
      {
        "schema": "note",
        "table": "create",
        "verbs": "act"
      },
      {
        "schema": "note",
        "table": "edit",
        "verbs": "act"
      },
      {
        "schema": "note",
        "table": "move",
        "verbs": "act"
      },
      {
        "schema": "container",
        "table": "create",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "retitle",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "trash",
        "verbs": "act"
      },
      {
        "schema": "entity",
        "table": "restore",
        "verbs": "act"
      },
      {
        "schema": "note",
        "table": "restore_version",
        "verbs": "act"
      },
      {
        "schema": "flag",
        "table": "set",
        "verbs": "act"
      },
      {
        "schema": "flag",
        "table": "clear",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "task",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "edge",
        "table": "remove",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "add",
        "verbs": "act"
      },
      {
        "schema": "tag",
        "table": "remove",
        "verbs": "act"
      }
    ]
  },
  "actionSideEffect": "vault-write",
  "actions": [
    {
      "name": "create-note",
      "verb": "create",
      "kind": "note",
      "inverse": "delete-note",
      "sealed": [],
      "chat": "direct",
      "command": "note.create",
      "phrasings": [
        "jot down that I need to call the plumber",
        "start a note called book ideas",
        "write a note about the trip itinerary"
      ],
      "description": "Create a note (optionally filed into a notebook) through note.create; the body is the note's own column and any [[wikilink]] in it compiles to a link edge.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 0
          },
          "format": {
            "type": "string",
            "enum": ["markdown", "plain"]
          },
          "notebook_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["title", "body"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "edit-note",
      "verb": "edit",
      "kind": "note",
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "note.edit",
      "phrasings": [
        "add oat milk to my shopping note",
        "retitle the book ideas note",
        "fix the first line of the trip itinerary"
      ],
      "description": "Edit a note's title, body or format through note.edit — partial update, only the fields sent change; the body it replaces is kept as a revision.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 0
          },
          "body": {
            "type": "string",
            "minLength": 0
          },
          "format": {
            "type": "string",
            "enum": ["markdown", "plain"]
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "move-note",
      "verb": "add_to",
      "kind": "note",
      "also": ["remove_from"],
      "inverse": null,
      "sealed": [],
      "chat": "direct",
      "command": "note.move",
      "phrasings": [
        "put the trip itinerary in the Travel notebook",
        "file my book ideas under Reading",
        "move the plumber note to Home"
      ],
      "description": "Refile a note into a notebook (or unfile it by sending no notebook_id) through note.move — one notebook per note.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "notebook_id": {
            "type": ["string", "null"],
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
