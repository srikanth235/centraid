  "queries": [
    {
      "name": "link-targets",
      "kind": "note",
      "figures": ["targets"],
      "description": "FTS5 powerbox search across notes, people, events, tasks, documents and photos; returns secret-free entity-aware link targets.",
      "input": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["term"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array"
          }
        }
      }
    },
    {
      "name": "library",
      "kind": "note",
      "figures": ["notes", "notebooks", "tags", "trash"],
      "description": "A bounded recent window of notes (newest by updated_at, pinned always included) with their notebook names, a short body preview (`preview`) and checklist tally (`check`), and tags (`[{concept_id, label}]`), plus the notebooks for filtering and the distinct tag list (`[{concept_id, label}]`) seen within the window — never a whole-table pull, and never full bodies (the editor pulls those via `note`); `truncated` says older notes exist beyond the window.",
      "input": {
