            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "month_day": {
            "type": "string",
            "pattern": "^(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
          },
          "reminder_on": {
            "type": "boolean"
          }
        },
        "required": ["id", "label", "month_day"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
