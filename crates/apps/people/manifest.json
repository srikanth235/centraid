    {
      "name": "add-person",
      "verb": "create",
      "kind": "person",
      "inverse": "trash-person",
      "sealed": [],
      "chat": "direct",
      "command": "person.add",
      "phrasings": [
        "add Sam Lee to my people",
        "save a contact called Maria, my dentist",
        "add my cousin Priya and remind me to call monthly"
      ],
      "description": "Add a person to your circle through person.add, optionally filed into a list. A cadence of 0 is no cadence.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The id the shell minted for this write (#922 G2); omitted, the vault mints one."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "met": {
            "type": "string"
          },
          "birthday": {
            "type": "string",
            "description": "MM-DD, or YYYY-MM-DD"
          },
          "cadence_days": {
            "type": "integer",
            "minimum": 0
          },
          "list_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "output": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
