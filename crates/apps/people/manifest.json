    {
      "name": "add-important-date",
      "description": "Add an important date through person.add_date. A birthday is the person's own column; any other date is a yearly all-day event about them. month_day is MM-DD.",
      "confirmation": "none",
      "input": {
        "type": "object",
        "properties": {
