{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // replica-sync-io.perf and the phone reconnect scale rig import
    // IndexedDB-backed client stores. Timer.unref is `unrefTimer` because
    // DOM `setTimeout` returns `number`.
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "perf/**/*.ts",
    "scale/**/*.ts",
    "quality/**/*.ts",
    "helpers/**/*.ts"
  ]
}
