{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "legend",
    "trackingIssues",
    "gaps",
    "revisitTriggers",
    "workspaceSurfaces",
    "cellOwners",
    "dimensions",
    "surfaces",
    "flows"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "legend": { "type": "object" },
    "trackingIssues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "state"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "state": { "enum": ["open", "closed"] }
        }
      }
    },
    "gaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trackingIssue"],
        "additionalProperties": false,
        "properties": {
          "trackingIssue": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "revisitTriggers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["glob", "trackingIssue"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "trackingIssue": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "workspaceSurfaces": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "cellOwners": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["owner", "tier"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "tier": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "label", "lane"] }
    },
    "surfaces": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "label", "assessment"] }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "surface", "dimension", "tier", "owner"],
        "properties": { "owner": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
