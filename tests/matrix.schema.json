{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "demonstratedRed",
    "qualities",
    "legend",
    "trackingIssues",
    "gaps",
    "revisitTriggers",
    "workspaceSurfaces",
    "cellOwners",
    "dimensions",
    "surfaces",
    "flows",
    "appEngines"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "demonstratedRed": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["command", "seed", "failure"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "seed": { "type": "string", "minLength": 1 },
          "failure": { "type": "string", "minLength": 1 }
        }
      }
    },
    "qualities": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "weakestLink", "gates"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "weakestLink": { "type": "string", "minLength": 1 },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "owner",
                "evidence",
                "lane",
                "wallClockCost",
                "knob",
                "governance",
                "redLastDemonstrated"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 },
                "lane": { "type": "string", "minLength": 1 },
                "wallClockCost": { "type": "string", "minLength": 1 },
                "knob": { "type": "string", "minLength": 1 },
                "governance": {
                  "enum": ["tighten-only", "waiver-gated", "none"]
                },
                "redLastDemonstrated": { "type": "string", "format": "date" },
                "blockedBy": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "legend": { "type": "object" },
    "trackingIssues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "state"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "state": { "enum": ["open", "closed"] }
        }
      }
    },
    "gaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trackingIssue"],
        "additionalProperties": false,
        "properties": {
          "trackingIssue": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "revisitTriggers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["glob", "trackingIssue"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "contains": {
            "type": "string",
            "minLength": 1,
            "description": "Regex the globbed files must NOT contain. Without it the trigger fires on mere existence, which is why a glob must always match at least one real file."
          },
          "trackingIssue": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "workspaceSurfaces": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "cellOwners": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["owner", "tier"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "tier": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "label", "lane"] }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "assessment"],
        "description": "`assessment` is a DECLARED EXPECTATION, not a grade: scripts/test-report/matrix-grades.mjs computes the ceiling the evidence supports and test:matrix fails when a cell claims more than that."
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "surface",
          "dimension",
          "tier",
          "owner",
          "minimumTests"
        ],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "minimumTests": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "The contract floor for this law. null opts a rig out of the floor and makes the cell it backs uncomputable as solid."
          }
        }
      }
    },
    "appEngines": {
      "type": "object",
      "required": ["seatDoctrine", "engines", "apps"],
      "additionalProperties": false,
      "properties": {
        "seatDoctrine": { "type": "string", "minLength": 1 },
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "flow"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "flow": { "type": "string", "minLength": 1 }
            }
          }
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "engines"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "engines": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["status", "flow"],
                      "additionalProperties": false,
                      "properties": {
                        "status": { "const": "pass" },
                        "flow": { "type": "string", "minLength": 1 }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["status", "reason", "citation"],
                      "additionalProperties": false,
                      "properties": {
                        "status": { "const": "skip" },
                        "reason": { "type": "string", "minLength": 1 },
                        "citation": { "type": "string", "minLength": 1 }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
