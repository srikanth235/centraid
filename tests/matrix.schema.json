{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "legend",
    "trackingIssues",
    "gaps",
    "revisitTriggers",
    "workspaceSurfaces",
    "cellOwners",
    "dimensions",
    "surfaces",
    "flows"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "legend": { "type": "object" },
    "trackingIssues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "state"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "state": { "enum": ["open", "closed"] }
        }
      }
    },
    "gaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trackingIssue"],
        "additionalProperties": false,
        "properties": {
          "trackingIssue": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "revisitTriggers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["glob", "trackingIssue"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "contains": {
            "type": "string",
            "minLength": 1,
            "description": "Regex the globbed files must NOT contain. Without it the trigger fires on mere existence, which is why a glob must always match at least one real file."
          },
          "trackingIssue": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "workspaceSurfaces": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "cellOwners": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["owner", "tier"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "tier": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "label", "lane"] }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "assessment"],
        "description": "`assessment` is a DECLARED EXPECTATION, not a grade: scripts/test-report/matrix-grades.mjs computes the ceiling the evidence supports and test:matrix fails when a cell claims more than that."
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "surface",
          "dimension",
          "tier",
          "owner",
          "minimumTests"
        ],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "minimumTests": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "The contract floor for this law. null opts a rig out of the floor and makes the cell it backs uncomputable as solid."
          }
        }
      }
    }
  }
}
