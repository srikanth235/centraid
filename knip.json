{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "actionlint",
    "gitleaks",
    "maestro",
    "osv-scanner",
    "trivy"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": ["enumMembers"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{js,mjs,ts}",
        "contracts/tools/*.ts",
        "desktop/renderer/src/main.tsx",
        "desktop/e2e/*.{ts,mjs}",
        "desktop/vitest.config.ts",
        ".github/workflows/*.{yml,yaml}"
      ],
      "project": [
        "scripts/**/*.{js,mjs,ts}",
        "desktop/renderer/src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "electron",
        "react",
        "react-dom"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/design": {
      "entry": ["src/index.ts", "src/elements/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/test-kit": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "desktop/electron": {
      "entry": ["src/main.ts", "src/preload.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    "extension": {
      "entry": [
        "src/worker.ts",
        "src/content.ts",
        "src/popup.ts",
        "scripts/*.mjs",
        "e2e/*.{ts,mjs}"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs"]
    }
  }
}
