{
  "name": "@centraid/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Centraid desktop — Electron shell + React renderer over the shared @centraid/client shell. Consumes @centraid/design.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun run build:ts && bun run build:preload && bun run build:assets && bun run build:react",
    "build:assets": "mkdir -p dist/renderer && cp ../../packages/client/src/index.html ../../packages/client/src/styles.css dist/renderer/ && node scripts/copy-fonts.mjs",
    "build:preload": "bun build src/preload.ts --target=node --format=cjs --external electron --outfile dist/preload.cjs",
    "build:react": "vite build",
    "build:ts": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "bun run build && electron .",
    "dist": "electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "electron-builder --config electron-builder.yml --dir --publish never",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/test-report/prepare.mjs --lane desktop-playwright && bun run build && playwright test -c tests/e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.react.json --noEmit"
  },
  "dependencies": {
    "@centraid/client": "workspace:*",
    "@centraid/design": "workspace:*",
    "@centraid/server": "workspace:*",
    "@centraid/tunnel": "workspace:*",
    "@centraid/vault": "workspace:*",
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@centraid/test-kit": "workspace:*",
    "@playwright/test": "~1.62.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "catalog:",
    "vite": "^8.2.1"
  }
}
