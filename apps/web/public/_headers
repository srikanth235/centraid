# SW-safe caching for the continuous public PWA (app.centraid.dev) — issue #501.
# HTML + SW revalidate; hashed assets under /assets/ long-cache.

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/centraid-worker-iroh.js
  Cache-Control: public, max-age=0, must-revalidate

/centraid-worker-iroh.wasm
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=300, must-revalidate

/offline.html
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Bundled Binding Layer faces (issue #707). Unhashed by design — the URL is
# baked into the token CSS the shell injects at boot — but the bytes are a
# pinned @fontsource version vendored into the repo, so a change ships as a
# new filename, not a new revision of one. Immutable is safe and correct.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
