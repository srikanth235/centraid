<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>AppGroupIdentifier</key>
    <string>group.dev.centraid.mobile</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
      <string>com.expo.modules.backgroundtask.processing</string>
    </array>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Centraid</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>centraid</string>
          <string>dev.centraid.mobile</string>
        </array>
      </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>1000</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- expo-dev-menu reads this via Bundle.main.object(forInfoDictionaryKey:)
         and registers it as the default for its onboarding flag. Without it the
         one-time "This is the developer menu" explainer opens over the app on
         every cleared-state launch — and CI reinstalls the dev build every run,
         so "one-time" means "every time", hiding whatever the flow asserts
         behind the sheet (#676). -->
    <key>EXDevMenuIsOnboardingFinished</key>
    <true/>
    <!-- expo-dev-menu's DevMenuManager.updateAutoLaunchObserver opens the menu
         on RCTContentDidAppear when showsAtLaunch || shouldShowOnboarding()
         (DevMenuPreferences registers showsAtLaunch's Info.plist default, true
         on iOS). The onboarding key above only kills the second disjunct —
         dispatch 32803482770 still showed the bare menu auto-opened over the
         rendered app. This key kills the first, so the menu never auto-opens
         on a fresh install; it stays reachable by gesture (#676). -->
    <key>EXDevMenuShowsAtLaunch</key>
    <false/>
    <!-- The FAB is its own UIWindow floating above the app with a hit area
         inset-expanded 10pt past its frame (DevMenuFABWindow.swift), so a
         Maestro tap near a screen's top-right control can land on it and open
         the dev menu mid-journey (places-seat's "Open map" tap, local run
         05-49-50). The menu stays reachable via keyboard/shake. -->
    <key>EXDevMenuShowFloatingActionButton</key>
    <false/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
      <key>NSAllowsLocalNetworking</key>
      <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Centraid uses the camera to scan pairing QR codes, documents, cards, and receipts you choose to capture.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Centraid uses Face ID to protect the local vault replica and unlock Locker secrets.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Centraid connects to the personal gateway you pair on your local network.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Centraid uses the microphone only when you choose to capture a video with sound.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Centraid saves selected vault photos back to your library.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Centraid reads your library to show and back up the albums you choose.</string>
    <key>RCTNewArchEnabled</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
      <string>processing</string>
      <string>remote-notification</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>SplashScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
      <string>arm64</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
  </dict>
</plist>
