<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and transfer rules for API 31 and above
     (android:dataExtractionRules). Same decision as replica_backup_rules.xml,
     stated for both extraction paths.

     device-transfer is the half that android:allowBackup cannot express:
     turning cloud backup off does not stop a device-to-device transfer, so a
     new phone would otherwise inherit this phone's replica cursors, cached
     scope manifest and freshness stamps while its own replica directory
     (noBackupFilesDir/CentraidReplica) arrived empty. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
