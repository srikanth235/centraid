<?xml version="1.0" encoding="utf-8"?>
<!-- The upload foreground service, declared by the module that owns it.

     This is a library manifest: AGP merges it into the app manifest, so the
     `<service>` entry and the three permissions it needs travel with the module
     rather than with a config plugin that patches the app manifest. Deleting
     the module deletes the declaration; there is no second place to remember.

     `android:name` is fully qualified on purpose — a library manifest's
     relative `.upload.Foo` form resolves against the *app's* package, which is
     `dev.centraid.mobile`, not this module's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.centraidupload.UploadForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
