<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API 30 and below (android:fullBackupContent).

     Centraid opts out of backup entirely, rather than excluding one store.

     The replica databases already live in noBackupFilesDir/CentraidReplica and
     never ride a backup (docs/mobile-offline.md, "Durable path and at-rest
     decision"). Everything else on this device DESCRIBES that replica: the
     AsyncStorage database (databases/RKStorage) holds the SSE resume cursors,
     the cached scope manifest and the per-source freshness stamps, and
     shared_prefs holds SecureStore blobs wrapped in Keystore keys that do not
     leave the device. Restoring any of it onto a phone whose replica is empty
     produces state that claims rows this device never had — cursors resume past
     changes that were never fetched, and Keystore-wrapped secrets restore as
     undecryptable bytes. Re-pairing is the honest restore path, and it costs one
     QR scan.

     Nothing is stored in device-encrypted storage, so the device_* domains have
     nothing to exclude. -->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
