{
  "name": "@centraid/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "bun scripts/check-import-boundaries.ts",
    "ci:versions": "expo install --check",
    "ci:bundle": "expo export --platform ios --output-dir ../../dist/mobile-bundle-smoke/ios --clear && expo export --platform android --output-dir ../../dist/mobile-bundle-smoke/android --clear",
    "ci:android-native": "cd android && ./gradlew :app:compileDebugKotlin --no-daemon",
    "ci:native-state": "node scripts/verify-native-state.mjs",
    "ci:xcode": "node scripts/check-xcode-minimum.mjs",
    "generate:theme": "bun scripts/generate-theme.ts",
    "eas:build:ios": "eas build --platform ios --profile preview --non-interactive",
    "eas:build:android": "eas build --platform android --profile preview --non-interactive",
    "eas:submit:ios": "eas submit --platform ios --profile preview --non-interactive --latest",
    "eas:submit:android": "eas submit --platform android --profile preview --non-interactive --latest"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@centraid/client": "workspace:*",
    "@centraid/design-tokens": "workspace:*",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "17.1.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/flash-list": "2.3.2",
    "expo": "~57.0.8",
    "expo-battery": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "*",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "jpeg-js": "^0.4.4",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-maps": "1.29.0",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.11.3",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@centraid/test-kit": "workspace:*",
    "@expo/fingerprint": "~0.20.6",
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "babel-preset-expo": "^57.0.4",
    "react-dom": "19.2.8",
    "typescript": "catalog:"
  },
  "op-sqlite": {
    "fts5": true
  }
}
